{
  "name": "reminderSend",
  "version": "1.0.0",
  "description": "每天 9 点检查周年提醒：提前 7 天经订阅消息下发",
  "main": "index.js",
  "permissions": {
    "openapi": [
      "subscribeMessage.send"
    ]
  },
  "triggers": [
    {
      "name": "dailyReminder",
      "type": "timer",
      "config": "0 0 9 * * * *"
    }
  ],
  "dependencies": {
    "wx-server-sdk": "~2.6.3"
  }
}
