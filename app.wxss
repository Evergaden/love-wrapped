/* 全局只有底色、字色和按钮。
   配色的唯一出处是 utils/themes.js：奶油（默认）、抹茶、晴蓝、雾紫四套。
   弥散底和卡口细线的颜色由 themes.js 算好以后内联在节点上
   （开发者工具里 swiper 内容对样式表的多级选择器级联不稳定，内联最可靠），
   这里只保留布局和按钮；其余主题差异写在两个页面的 wxss 里。
   导出图片的同色在 utils/poster.js，也从 themes.js 取。 */

page {
  background: #FFF5F7;
  color: #2D1B24;
  font-family: "LXGW WenKai", "Smiley Sans", "PingFang SC", "Hiragino Sans GB", "Heiti SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
}

view,
text,
input,
textarea,
scroll-view,
swiper,
swiper-item {
  box-sizing: border-box;
}

.btn {
  height: 92rpx;
  line-height: 88rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: opacity 140ms ease, transform 140ms ease, box-shadow 140ms ease;
}

.btn-primary {
  background: #FF8FAB;
  color: #2D1B24;
  box-shadow: 0 12rpx 28rpx rgba(255, 138, 171, 0.30);
}

.btn-ghost {
  background: transparent;
  color: rgba(45, 27, 36, 0.82);
  border-color: #FFC2D1;
}

.pressed {
  opacity: 0.78;
}

/* 按钮按下去有一个很小的回弹，读起来更像成品。 */
.btn.pressed {
  opacity: 0.94;
  transform: scale(0.985);
}

/* 弥散底。
   几摊颜色各自化开，摊在一起互相渗透，铺满整页。
   这里只管铺法（铺满、不重复），background-image 由 themes.js 生成后内联。 */
.mesh {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
  background-repeat: no-repeat;
  background-size: 100% 100%;
}

/* 顶部那层白光。让页面像蒙了一层柔光，字更清楚。 */
.bloom {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 40%;
  pointer-events: none;
  background-image: radial-gradient(72% 100% at 50% 0%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0) 72%);
}

/* 卡面上那条渐变细线。颜色由 themes.js 生成后内联。 */
.hairline {
  height: 6rpx;
  border-radius: 6rpx;
}

/* —— 其余主题的按钮覆盖。弥散底已内联，不需要这里的规则。 —— */

.theme-matcha .btn-primary {
  background: #7FC79B;
  color: #1E2B23;
  box-shadow: 0 12rpx 28rpx rgba(127, 199, 155, 0.30);
}

.theme-matcha .btn-ghost {
  color: rgba(30, 43, 35, 0.82);
  border-color: #C8E9D2;
}

.theme-sky .btn-primary {
  background: #8FB6E8;
  color: #1C2A3C;
  box-shadow: 0 12rpx 28rpx rgba(143, 182, 232, 0.30);
}

.theme-sky .btn-ghost {
  color: rgba(28, 42, 60, 0.82);
  border-color: #CFE2F8;
}

.theme-violet .btn-primary {
  background: #B49AEC;
  color: #2B2144;
  box-shadow: 0 12rpx 28rpx rgba(180, 154, 236, 0.30);
}

.theme-violet .btn-ghost {
  color: rgba(43, 33, 68, 0.82);
  border-color: #E4D4FA;
}

