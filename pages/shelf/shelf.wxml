<view class="page theme-{{theme}}" style="background: {{themeBg}}">
  <view class="wrap">
    <!-- 顶栏：标题在左，「我的」在右，跟参考主页一样清爽。 -->
    <!-- 顶栏：大标题独占，入口都收进底部胶囊。 -->
    <text class="page-title">你们的小书架</text>

    <!-- 收好的册子：一张一张全宽的 pastel 卡，写了一半的排第一。 -->
    <view class="section-row" wx:if="{{hasDraft || books.length}}">
      <text class="section-title">我的册子</text>
    </view>

    <view
      class="book-card {{item.draft ? 'is-draft' : ''}}"
      wx:for="{{shelfItems}}"
      wx:key="id"
      style="background: {{item.cardBg}}"
      hover-class="pressed"
      bindtap="onCoverTap"
      data-id="{{item.id}}"
      data-draft="{{item.draft ? 1 : ''}}"
      aria-role="button"
    >
      <view class="card-tag" wx:if="{{item.tagText}}">
        <text class="card-tag-text">{{item.tagText}}</text>
      </view>
      <text class="card-title">{{item.title}}</text>
      <view class="card-meta">
        <text class="card-meta-line">{{item.dateText || '日子还没选'}}</text>
        <text class="card-meta-line" wx:if="{{item.draft}}">{{item.canOpen ? '可以生成啦' : '写了一半，回去接着写'}}</text>
        <text class="card-meta-line" wx:else>收于 {{item.timeText}}</text>
      </view>
      <view class="card-foot">
        <text class="card-load" wx:if="{{!item.draft}}" hover-class="pressed" catchtap="onReloadBook" data-id="{{item.id}}">载回</text>
      </view>
      <view class="card-doodle">
        <view class="card-doodle-icon"></view>
      </view>
    </view>

    <text class="soft-error" wx:if="{{softError}}">{{softError}}</text>

    <!-- 云端还没回音：先让书架陪着你。 -->
    <view class="empty" wx:if="{{state === 'loading' && !slow}}">
      <text class="empty-text">正在翻书架…</text>
    </view>

    <!-- 第一次来 / 书架空空：一句温柔的引导，新写一本的按钮就在下面。 -->
    <view class="guide" wx:if="{{showGuide}}">
      <text class="guide-title">这里以后摆你们的小册子</text>
      <text class="guide-text">写下两个名字和一些小事，第一本就长出来了。</text>
    </view>

    <text class="hint" wx:if="{{hasDraft && !books.length && state === 'ok'}}">写完点「生成纪念册」，它就会自动收进这个书架。</text>
    <view class="quiet-row" wx:if="{{books.length && state === 'ok'}}">
      <view class="quiet" hover-class="pressed" bindtap="onManage" aria-role="button">管理这些册子 ›</view>
    </view>
  </view>

  <!-- 左下角浮动胶囊：主页 / 我的（参考截图的底部导航，纯文字）。 -->
  <view class="nav-pill">
    <view class="nav-item is-on" hover-class="pressed" bindtap="onHomeTap" aria-role="button">主页</view>
    <view class="nav-item" hover-class="pressed" bindtap="onProfile" aria-role="button">我的</view>
  </view>

  <!-- 右下角最显眼的一颗：新写一本。 -->
  <view class="fab" hover-class="pressed" bindtap="onStart" aria-role="button" aria-label="新写一本">
    <text class="fab-plus">＋</text>
    <text class="fab-text">新写一本</text>
  </view>
</view>
