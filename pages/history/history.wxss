/* 历史记录页：云端书架。一行一册，软卡片。 */

.page {
  min-height: 100vh;
}

.wrap {
  padding: 48rpx 40rpx 80rpx;
}

.empty {
  padding: 120rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2D1B24;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 27rpx;
  line-height: 1.7;
  color: rgba(45, 27, 36, 0.55);
  text-align: center;
}

.book {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 30rpx 32rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.66);
  box-shadow: inset 0 0 0 2rpx rgba(255, 194, 209, 0.45);
}

.book-main {
  flex: 1;
  min-width: 0;
}

.book-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2D1B24;
}

.book-meta {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(45, 27, 36, 0.5);
}

.book-del {
  flex: none;
  margin-left: 20rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(232, 90, 122, 0.1);
  color: #C04360;
  font-size: 25rpx;
}

.pressed {
  opacity: 0.7;
}

.hint {
  display: block;
  margin-top: 28rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(45, 27, 36, 0.45);
  text-align: center;
}
