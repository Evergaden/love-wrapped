/* 我的页。和填写页同一套奶油系视觉：软卡片、细描边、安静的正文。 */

.page {
  min-height: 100vh;
  font-family: inherit;
}

.wrap {
  padding: 64rpx 40rpx 80rpx;
}

.page-title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #2D1B24;
}

.page-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.55);
}

.card {
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.66);
  box-shadow: inset 0 0 0 2rpx rgba(255, 194, 209, 0.35);
}

.section-title { display: block; margin: 48rpx 8rpx 18rpx; font-size: 26rpx; font-weight: 600; color: #715460; }
.settings-list { border-radius: 30rpx; padding: 0 32rpx; background: rgba(255,255,255,.66); }
.settings-row { display: flex; align-items: center; justify-content: space-between; min-height: 108rpx; padding: 24rpx 0; margin: 0; border-radius: 0; background: transparent; color: #2D1B24; text-align: left; font-size: 29rpx; line-height: 1.5; border-bottom: 1rpx solid #F1E1E6; }
.settings-row:last-child { border-bottom: 0; }
.settings-row::after { border: 0; }
.settings-row { width: 100%; box-sizing: border-box; font-family: inherit; font-weight: 400; }
.row-arrow { width: 12rpx; height: 12rpx; margin-left: 24rpx; margin-right: 4rpx; border-top: 2rpx solid #987B87; border-right: 2rpx solid #987B87; transform: rotate(45deg); flex-shrink: 0; }

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #2D1B24;
}

.chev {
  font-size: 40rpx;
  color: rgba(45, 27, 36, 0.35);
}

.card-body {
  display: block;
  margin-top: 12rpx;
  font-size: 27rpx;
  line-height: 1.6;
  color: rgba(45, 27, 36, 0.6);
}

.card-body.warn {
  color: #B4532A;
}

/* 状态胶囊。 */
.state {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: rgba(45, 27, 36, 0.08);
  color: rgba(45, 27, 36, 0.55);
}

.state.ok {
  background: rgba(143, 211, 168, 0.28);
  color: #2E8B62;
}

.state.due {
  background: rgba(217, 164, 65, 0.18);
  color: #A8752B;
}

.state.error {
  background: rgba(232, 90, 122, 0.16);
  color: #C04360;
}

.pressed {
  opacity: 0.7;
}

.ghost {
  margin-top: 20rpx;
  padding: 16rpx 30rpx;
  border-radius: 999rpx;
  background: rgba(232, 90, 122, 0.1);
  color: #C04360;
  font-size: 26rpx;
  text-align: center;
}

/* 纪念日提醒：节点行、小按钮、添加区的种类 chips。 */
.node {
  margin-top: 26rpx;
  padding-top: 26rpx;
  border-top: 2rpx dashed rgba(45, 27, 36, 0.12);
}

.node-first {
  border-top: none;
  padding-top: 0;
}

.node-line {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.node-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #2D1B24;
}

.node-next {
  font-size: 24rpx;
  color: rgba(45, 27, 36, 0.45);
}

.node-body {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(45, 27, 36, 0.6);
}

.node-btns {
  display: flex;
  flex-wrap: wrap;
}

.node-btns .ghost.slim {
  margin-right: 16rpx;
}

.ghost.slim {
  display: inline-block;
  margin-top: 16rpx;
  padding: 12rpx 26rpx;
  font-size: 24rpx;
}

.ghost-plain {
  background: rgba(45, 27, 36, 0.06);
  color: rgba(45, 27, 36, 0.55);
}

.ghost-dim {
  background: rgba(45, 27, 36, 0.04);
  color: rgba(45, 27, 36, 0.4);
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 4rpx;
}

.chip {
  margin: 16rpx 16rpx 0 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(232, 90, 122, 0.08);
  color: #C04360;
  font-size: 25rpx;
}

.chip-on {
  background: rgba(232, 90, 122, 0.2);
  font-weight: 600;
}

.chip-dim {
  background: rgba(45, 27, 36, 0.05);
  color: rgba(45, 27, 36, 0.4);
}
