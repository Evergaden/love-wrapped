<view class="page" style="background: {{themeBg}}">
  <view class="wrap">
    <text class="page-title">我的</text>
    <text class="page-sub">{{appName}}</text>

    <!-- 云同步状态 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">云同步</text>
        <view
          class="state {{cloudState}}"
          hover-class="{{cloudState === 'error' ? 'pressed' : ''}}"
          bindtap="{{cloudState === 'error' ? 'onRetryCloud' : ''}}"
        >
          <text wx:if="{{cloudState === 'checking'}}">看看云端…</text>
          <text wx:elif="{{cloudState === 'ok'}}">已自动备份</text>
          <text wx:else>点我重试</text>
        </view>
      </view>
      <text class="card-body warn" wx:if="{{cloudState === 'error'}}">{{cloudError}}</text>
      <text class="card-body" wx:elif="{{cloudState === 'checking'}}">正在看一眼云端，马上就好。</text>
      <text class="card-body" wx:elif="{{cloudState === 'ok'}}">写下的内容都悄悄替你备份着，换台手机也在。</text>
    </view>

    <!-- 周年提醒：可取消，可重新开启（重新开启是真正的点击手势，才能拉起授权） -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">周年提醒</text>
        <view class="state {{reminderState === 'on' ? 'ok' : ''}}">
          <text wx:if="{{reminderState === 'on'}}">已开启</text>
          <text wx:elif="{{reminderState === 'off'}}">已取消</text>
          <text wx:else>未开启</text>
        </view>
      </view>
      <text class="card-body" wx:if="{{reminderState === 'on'}}">下个周年（{{reminderDate}}）前 7 天提醒你。</text>
      <text class="card-body" wx:elif="{{reminderState === 'off'}}">已取消，这个周年不会再提醒。</text>
      <text class="card-body" wx:else>还没开过。写好一册生成时，会轻轻问你一次。</text>
      <view class="ghost" hover-class="pressed" bindtap="onCancelReminder" wx:if="{{reminderState === 'on'}}" aria-role="button">取消提醒</view>
      <view class="ghost" hover-class="pressed" bindtap="onEnableReminder" wx:elif="{{reminderState === 'off'}}" aria-role="button">重新开启</view>
    </view>

    <!-- 历史记录 -->
    <view class="card link" hover-class="pressed" bindtap="goHistory" aria-role="button">
      <view class="card-head">
        <text class="card-title">历史记录</text>
        <text class="chev">›</text>
      </view>
      <text class="card-body">翻看之前写过的册子，可以载回填写页，也可以删掉。</text>
    </view>
  </view>
</view>
