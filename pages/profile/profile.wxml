<view class="page" style="background: {{themeBg}}">
  <view class="wrap">
    <text class="page-title">我的</text>
    <text class="page-sub">{{appName}}</text>

    <!-- 云同步状态 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">云同步</text>
        <view
          class="state {{cloudState}}"
          hover-class="{{cloudState === 'error' ? 'pressed' : ''}}"
          bindtap="{{cloudState === 'error' ? 'onRetryCloud' : ''}}"
        >
          <text wx:if="{{cloudState === 'checking'}}">看看云端…</text>
          <text wx:elif="{{cloudState === 'ok'}}">已自动备份</text>
          <text wx:else>点我重试</text>
        </view>
      </view>
      <text class="card-body warn" wx:if="{{cloudState === 'error'}}">{{cloudError}}</text>
      <text class="card-body" wx:elif="{{cloudState === 'checking'}}">正在看一眼云端，马上就好。</text>
      <text class="card-body" wx:elif="{{cloudState === 'ok'}}">写下的内容都悄悄替你备份着，换台手机也在。</text>
    </view>

    <!-- 纪念日提醒（多节点）：每个节点的授权都要单独一次点击
         （微信订阅消息一次授权只能发一条），开启/续订按钮必须是真 TAP。 -->
    <view class="card">
      <view class="card-head">
        <text class="card-title">纪念日提醒</text>
        <view class="state {{onCount === nodes.length && nodes.length > 0 ? 'ok' : ''}}">
          <text>{{nodes.length === 0 ? '还没挂日子' : (onCount === nodes.length ? '都开着' : onCount + ' / ' + nodes.length)}}</text>
        </view>
      </view>
      <text class="card-body">这些日子前 7 天，微信里会轻轻提醒你一次。</text>

      <block wx:if="{{nodes.length > 0}}">
        <view class="node {{index === 0 ? 'node-first' : ''}}" wx:for="{{nodes}}" wx:key="kind">
          <view class="node-line">
            <text class="node-name">{{item.label}}</text>
            <text class="node-next">{{item.nextText}}</text>
          </view>
          <text class="node-body">{{item.body}}</text>
          <view class="node-btns">
            <view class="ghost slim" hover-class="pressed" wx:if="{{item.canOn}}" data-idx="{{index}}" bindtap="onNodeEnable" aria-role="button">{{item.btnText}}</view>
            <view class="ghost slim ghost-plain" hover-class="pressed" wx:if="{{item.canCancel}}" data-idx="{{index}}" bindtap="onNodeCancel" aria-role="button">取消</view>
            <view class="ghost slim ghost-dim" hover-class="pressed" wx:if="{{item.canDelete}}" data-idx="{{index}}" bindtap="onNodeDelete" aria-role="button">删除</view>
          </view>
        </view>
      </block>
      <text class="card-body" wx:else>写好一册，你们在一起的日子会自动出现在这里；生日、告白这些日子也可以自己加。</text>

      <view class="ghost" hover-class="pressed" wx:if="{{!adding}}" bindtap="onAddToggle" aria-role="button">＋ 添加一个纪念日</view>
      <block wx:if="{{adding}}">
        <view class="chip-row">
          <view
            class="chip {{pendingKind === k.id ? 'chip-on' : ''}}"
            hover-class="pressed"
            wx:for="{{addable}}"
            wx:for-item="k"
            wx:key="id"
            data-kind="{{k.id}}"
            bindtap="onPickKind"
          >{{k.label}}</view>
          <text class="chip chip-dim" wx:if="{{addable.length === 0}}">能加的日子都加齐啦</text>
        </view>
        <picker wx:if="{{pendingKind}}" mode="date" start="1970-01-01" end="{{today}}" value="{{today}}" bindchange="onAddDate">
          <view class="ghost" hover-class="pressed">选「{{pendingLabel}}」的日子</view>
        </picker>
      </block>
    </view>

    <!-- 历史记录 -->
    <view class="card link" hover-class="pressed" bindtap="goHistory" aria-role="button">
      <view class="card-head">
        <text class="card-title">历史记录</text>
        <text class="chev">›</text>
      </view>
      <text class="card-body">翻看之前写过的册子，可以载回填写页，也可以删掉。</text>
    </view>
  </view>
</view>
