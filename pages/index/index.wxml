<view class="page theme-{{theme}}" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd">
  <!-- 自定义导航栏：顶部透明，下滑渐变成毛玻璃，吸顶显示已写进度。 -->
  <view class="nav {{collapsed ? 'nav-solid' : ''}}" style="padding-top: {{statusBarH}}px">
    <view class="nav-row" style="height: {{navInnerH}}px; padding-right: {{capsulePad}}px">
      <view class="nav-back" hover-class="pressed" bindtap="goShelf" aria-role="button" aria-label="回到书架">
        <view class="nav-back-arrow"></view>
      </view>
      <text class="nav-title" style="opacity: {{navTitleOpacity}}">{{appName}}</text>
      <view class="nav-progress" style="opacity: {{navProgressOpacity}}">
        <view class="nav-track">
          <view class="nav-fill" style="width: {{filledPercent}}%"></view>
        </view>
        <text class="nav-count">{{filledCount}} / {{totalCount}}</text>
      </view>
    </view>
  </view>

  <!-- 弥散底：两摊颜色化开铺在整页上，页面往下滑它不动，
       所以整张表单像铺在一层会流动的光里。颜色由 themes.js 算好直接内联。 -->
  <view class="hero-wrap" style="transform: translateY({{heroShift}}px) scale({{heroScale}}); opacity: {{heroWrapOpacity}}; padding-top: {{navTotalH}}px; overflow: hidden; background: {{heroWrapBg}}; transform-origin: top center">
  <view class="ambient">
    <view class="mesh mesh-1" style="background-image: {{ambientMesh}}"></view>
    <view class="mesh amb-lower" style="background-image: {{ambientLower}}"></view>
    <view class="bloom"></view>
    <view class="amb-fade" style="background: {{ambientFade}}"></view>
  </view>
  <view class="hero-dim" style="opacity: {{heroDim}}"></view>

  <view class="hero" style="opacity: {{heroContentOpacity}}">
    <view class="hero-top">
      <view class="eyebrow-row">
        <view class="eyebrow-dot"></view>
        <text class="eyebrow">写给你们的小册子</text>
      </view>
    </view>
    <text class="hero-title" style="opacity: {{heroTitleOpacity}}; transform: scale({{heroTitleScale}})">{{appName}}</text>
    <text class="hero-sub" style="opacity: {{heroSubOpacity}}">由你写下两个名字和一些小事。生成之后可以左右滑动，像翻一本只印了一份的小册子。</text>

    <view class="progress" style="opacity: {{heroProgressOpacity}}">
      <view class="progress-track">
        <view class="progress-fill" style="width: {{filledPercent}}%"></view>
      </view>
      <text class="progress-text">已经写下 {{filledCount}} / {{totalCount}} 项</text>
    </view>
  </view>
  </view>

  <view class="sheet">
    <view class="group">
      <view class="group-head">
        <text class="group-no">01</text>
        <view class="group-text">
          <text class="group-title">先认识你们</text>
          <text class="group-hint">昵称和在一起的日子是必填的，别的都可以慢慢补。</text>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">你的昵称</text>
        <input
          class="field"
          maxlength="10"
          placeholder="比如：小熊"
          placeholder-class="ph"
          cursor-spacing="80"
          value="{{form.myNickname}}"
          data-key="myNickname"
          bindinput="onInput"
        />
      </view>

      <view class="field-block">
        <text class="field-label">TA 的昵称</text>
        <input
          class="field"
          maxlength="10"
          placeholder="比如：阿树"
          placeholder-class="ph"
          cursor-spacing="80"
          value="{{form.theirNickname}}"
          data-key="theirNickname"
          bindinput="onInput"
        />
      </view>

      <view class="field-block">
        <text class="field-label">在一起的日子</text>
        <picker mode="date" value="{{form.togetherDate}}" start="1990-01-01" end="2035-12-31" bindchange="onDate">
          <view class="field field-picker">
            <text wx:if="{{togetherDateText}}">{{togetherDateText}}</text>
            <text wx:else class="ph">选择那一天</text>
          </view>
        </picker>
      </view>

      <view class="field-block">
        <text class="field-label">第一次约会的地方</text>
        <input
          class="field"
          maxlength="20"
          placeholder="比如：学校西门的甜品店"
          placeholder-class="ph"
          cursor-spacing="80"
          value="{{form.firstDatePlace}}"
          data-key="firstDatePlace"
          bindinput="onInput"
        />
      </view>
    </view>

    <view class="group">
      <view class="group-head">
        <text class="group-no">02</text>
        <view class="group-text">
          <text class="group-title">一起走过的地方</text>
          <text class="group-hint">把名字写下来，纪念册帮你数一数、算一算。记不清就留空。</text>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">你们常住的城市</text>
        <text class="field-help">就当是你们俩的家。去过的地方，会一块一块标出离它多远。</text>
        <input
          class="field"
          maxlength="12"
          placeholder="比如：杭州"
          placeholder-class="ph"
          cursor-spacing="80"
          value="{{form.homeCity}}"
          data-key="homeCity"
          bindinput="onInput"
        />
      </view>

      <view class="field-block">
        <text class="field-label">一起去过的地方</text>
        <text class="field-help">一个一个加，最多放八块。认得出的城市会标出离你们家多远。</text>
        <view class="chips-input">
          <input
            class="field chips-field"
            maxlength="12"
            placeholder="输入城市名"
            placeholder-class="ph"
            confirm-type="done"
            cursor-spacing="80"
            value="{{placeDraft}}"
            bindinput="onPlaceDraft"
            bindconfirm="onAddPlace"
          />
          <view class="chips-add" hover-class="pressed" bindtap="onAddPlace">添加</view>
        </view>
        <view class="chips" wx:if="{{placeList.length}}">
          <view class="chip" wx:for="{{placeList}}" wx:key="*this">
            <text class="chip-text">{{item}}</text>
            <text class="chip-x" data-name="{{item}}" catchtap="onRemovePlace" aria-role="button" aria-label="删除{{item}}">×</text>
          </view>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">一起吃饭这件事</text>
        <text class="field-help">没人记得清吃过多少顿。选个大概，纪念册会按在一起的天数帮你估。</text>
        <radio-group class="choices" bindchange="onMeal">
          <label class="choice {{form.mealMode === '' ? 'on' : ''}}">
            <radio value="skip" checked="{{form.mealMode === ''}}" color="{{accentColor}}" />
            <text>先不写</text>
          </label>
          <label class="choice {{form.mealMode === 'daily' ? 'on' : ''}}">
            <radio value="daily" checked="{{form.mealMode === 'daily'}}" color="{{accentColor}}" />
            <text>几乎每天一起吃</text>
          </label>
          <label class="choice {{form.mealMode === 'often' ? 'on' : ''}}">
            <radio value="often" checked="{{form.mealMode === 'often'}}" color="{{accentColor}}" />
            <text>一周好几顿</text>
          </label>
          <label class="choice {{form.mealMode === 'few' ? 'on' : ''}}">
            <radio value="few" checked="{{form.mealMode === 'few'}}" color="{{accentColor}}" />
            <text>想起来才一起吃</text>
          </label>
          <label class="choice {{form.mealMode === 'lost' ? 'on' : ''}}">
            <radio value="lost" checked="{{form.mealMode === 'lost'}}" color="{{accentColor}}" />
            <text>数不清啦</text>
          </label>
        </radio-group>
      </view>
    </view>

    <view class="group">
      <view class="group-head">
        <text class="group-no">03</text>
        <view class="group-text">
          <text class="group-title">那些记得住的事</text>
          <text class="group-hint">「吵架」和「异地 / 同城」两项都留空，就不会多出页面。</text>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">你们最爱吃的东西</text>
        <view class="fave-row">
          <view class="fave-col">
            <text class="fave-cap">我的</text>
            <input
              class="field"
              maxlength="12"
              placeholder="比如：麻辣烫"
              placeholder-class="ph"
              cursor-spacing="80"
              value="{{form.myFave}}"
              data-key="myFave"
              bindinput="onInput"
            />
          </view>
          <view class="fave-col">
            <text class="fave-cap">TA 的</text>
            <input
              class="field"
              maxlength="12"
              placeholder="比如：草莓"
              placeholder-class="ph"
              cursor-spacing="80"
              value="{{form.theirFave}}"
              data-key="theirFave"
              bindinput="onInput"
            />
          </view>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">吵架</text>
        <text class="field-help">次数和「谁先道歉」写了任意一项，纪念册里会多一页。都留空就没有这一页。</text>
        <input
          class="field"
          type="number"
          maxlength="5"
          placeholder="次数，可不填。比如：2"
          placeholder-class="ph"
          cursor-spacing="80"
          value="{{form.fightCount}}"
          data-key="fightCount"
          bindinput="onInput"
        />
        <radio-group class="choices" bindchange="onWho">
          <label class="choice {{form.whoApologized === '' ? 'on' : ''}}">
            <radio value="skip" checked="{{form.whoApologized === ''}}" color="{{accentColor}}" />
            <text>先不写</text>
          </label>
          <label class="choice {{form.whoApologized === 'me' ? 'on' : ''}}">
            <radio value="me" checked="{{form.whoApologized === 'me'}}" color="{{accentColor}}" />
            <text>我先道歉</text>
          </label>
          <label class="choice {{form.whoApologized === 'them' ? 'on' : ''}}">
            <radio value="them" checked="{{form.whoApologized === 'them'}}" color="{{accentColor}}" />
            <text>TA 先道歉</text>
          </label>
          <label class="choice {{form.whoApologized === 'both' ? 'on' : ''}}">
            <radio value="both" checked="{{form.whoApologized === 'both'}}" color="{{accentColor}}" />
            <text>几乎同时</text>
          </label>
        </radio-group>
      </view>

      <view class="field-block">
        <text class="field-label">口头禅</text>
        <input
          class="field"
          maxlength="24"
          placeholder="比如：到了跟我说一声"
          placeholder-class="ph"
          cursor-spacing="80"
          value="{{form.catchphrase}}"
          data-key="catchphrase"
          bindinput="onInput"
        />
      </view>

      <view class="field-block">
        <text class="field-label">一件难忘的小事</text>
        <textarea
          class="textarea"
          maxlength="140"
          placeholder="下雨天、一顿饭、一句没头没尾的话，都可以。"
          placeholder-class="ph"
          cursor-spacing="100"
          value="{{form.story}}"
          data-key="story"
          bindinput="onInput"
        />
        <text class="counter">{{storyCount}} / 140</text>
      </view>
    </view>

    <view class="group">
      <view class="group-head">
        <text class="group-no">04</text>
        <view class="group-text">
          <text class="group-title">还有一页留给你</text>
          <text class="group-hint">选了距离就多一页。最后那句话，会印在最后一页。</text>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">异地，还是同城</text>
        <text class="field-help">选了才会多出这一页。异地写两座城市，公里数自动算；同城选个见面频率。</text>
        <radio-group class="choices" bindchange="onDistance">
          <label class="choice {{form.distanceMode === '' ? 'on' : ''}}">
            <radio value="skip" checked="{{form.distanceMode === ''}}" color="{{accentColor}}" />
            <text>先不写</text>
          </label>
          <label class="choice {{form.distanceMode === 'ldr' ? 'on' : ''}}">
            <radio value="ldr" checked="{{form.distanceMode === 'ldr'}}" color="{{accentColor}}" />
            <text>我们异地</text>
          </label>
          <label class="choice {{form.distanceMode === 'same' ? 'on' : ''}}">
            <radio value="same" checked="{{form.distanceMode === 'same'}}" color="{{accentColor}}" />
            <text>同一座城</text>
          </label>
        </radio-group>
        <view wx:if="{{form.distanceMode === 'ldr'}}" class="follow">
          <text class="field-label">我的城市</text>
          <text class="field-help">异地这段日子，你人在的这一座。</text>
          <input
            class="field"
            maxlength="12"
            placeholder="比如：上海"
            placeholder-class="ph"
            cursor-spacing="80"
            value="{{form.myCity}}"
            data-key="myCity"
            bindinput="onInput"
          />
          <text class="field-label">TA 的城市</text>
          <text class="field-help">TA 现在人所在的那一座。</text>
          <input
            class="field"
            maxlength="12"
            placeholder="比如：成都"
            placeholder-class="ph"
            cursor-spacing="80"
            value="{{form.theirCity}}"
            data-key="theirCity"
            bindinput="onInput"
          />
          <text class="field-help">两座城市都写得出来，中间隔着多少公里就自动算好了。</text>
        </view>
        <view wx:if="{{form.distanceMode === 'same'}}" class="follow">
          <text class="field-label">见面这件事</text>
          <text class="field-help">同城的人也未必天天见。选个大概，纪念册按在一起的天数帮你估。</text>
          <radio-group class="choices" bindchange="onMeet">
            <label class="choice {{form.meetMode === '' ? 'on' : ''}}">
              <radio value="skip" checked="{{form.meetMode === ''}}" color="{{accentColor}}" />
              <text>先不写</text>
            </label>
            <label class="choice {{form.meetMode === 'daily' ? 'on' : ''}}">
              <radio value="daily" checked="{{form.meetMode === 'daily'}}" color="{{accentColor}}" />
              <text>几乎天天见</text>
            </label>
            <label class="choice {{form.meetMode === 'often' ? 'on' : ''}}">
              <radio value="often" checked="{{form.meetMode === 'often'}}" color="{{accentColor}}" />
              <text>一周见好几回</text>
            </label>
            <label class="choice {{form.meetMode === 'few' ? 'on' : ''}}">
              <radio value="few" checked="{{form.meetMode === 'few'}}" color="{{accentColor}}" />
              <text>忙起来才见</text>
            </label>
            <label class="choice {{form.meetMode === 'lost' ? 'on' : ''}}">
              <radio value="lost" checked="{{form.meetMode === 'lost'}}" color="{{accentColor}}" />
              <text>没数过</text>
            </label>
          </radio-group>
        </view>
      </view>

      <view class="field-block">
        <text class="field-label">想对 TA 说的一句话</text>
        <textarea
          class="textarea textarea-short"
          maxlength="40"
          placeholder="比如：明年还想和你一起吃西瓜。"
          placeholder-class="ph"
          cursor-spacing="120"
          value="{{form.sentence}}"
          data-key="sentence"
          bindinput="onInput"
        />
        <text class="counter">{{sentenceCount}} / 40</text>
      </view>
    </view>

    <view class="group">
      <view class="group-head">
        <text class="group-no">05</text>
        <view class="group-text">
          <text class="group-title">挑一套配色</text>
          <text class="group-hint">整本纪念册、导出的图片和转发卡片都会用这套颜色，随时可以换。</text>
        </view>
      </view>
      <view class="swatches">
        <view
          class="swatch {{theme === item.id ? 'on' : ''}}"
          wx:for="{{themeList}}"
          wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTheme"
          hover-class="pressed"
        >
          <view class="swatch-dot" style="background: {{item.bg}}; border-color: {{item.accent}}"></view>
          <text class="swatch-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="tail">
      <view class="btn btn-ghost sample-btn" hover-class="pressed" bindtap="onSample">填入一组示例</view>
      <text class="sample-note">示例是虚构的小熊和阿树，一共 9 页。想从零开始，点下面的「清空重写」。</text>

      <view class="quiet-row" wx:if="{{hasStored}}">
        <view class="quiet" hover-class="pressed" bindtap="onClear" aria-role="button">清空重写</view>
      </view>
      <text class="privacy privacy-link" bindtap="onOpenPrivacyContract" aria-role="button">用户隐私保护指引</text>
    </view>
  </view>

  <view class="action-bar">
    <text class="count-line">会生成 {{slideCount}} 页</text>
    <view class="btn btn-primary {{canOpen ? '' : 'dim'}}" hover-class="pressed" bindtap="onGenerate">生成纪念册</view>
  </view>

  <!-- 周年提醒：自制弹层。requestSubscribeMessage 必须由用户 TAP 同步触发，
       原生 showModal 的确认按钮不算页面手势，真机弹不出授权，所以换掉它。 -->
  <view class="remind-mask" wx:if="{{remindAsk}}" bindtap="onReminderDecline" catchtouchmove="noop">
    <view class="remind-card" catchtap="noop">
      <text class="remind-title">{{remindAsk.title}}</text>
      <text class="remind-body">{{remindAsk.body}}</text>
      <text class="remind-hint" wx:if="{{remindAsk.hint}}">{{remindAsk.hint}}</text>
      <view class="remind-btns">
        <button class="remind-btn remind-btn-no" hover-class="pressed" bindtap="onReminderDecline">先不</button>
        <button class="remind-btn remind-btn-yes" hover-class="pressed" bindtap="onReminderAgree">好呀</button>
      </view>
    </view>
  </view>
</view>
