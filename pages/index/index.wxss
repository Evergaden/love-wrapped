.page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.hero {
  position: relative;
  padding: 44rpx 48rpx 20rpx;
}

/* 装饰：两团柔和色晕，都收在右上角。
   用 radial-gradient 淡到透明，所以边缘是化开的，不是切出来的直线。
   偏移量都留在渐变已经全透明的那一段里，不会被容器切出硬边。 */
.glow {
  position: absolute;
  pointer-events: none;
}

.glow-rose {
  width: 320rpx;
  height: 320rpx;
  right: -10rpx;
  top: -40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 138, 171, 0.20) 0%,
    rgba(255, 138, 171, 0.09) 29%,
    rgba(255, 194, 209, 0.03) 48%,
    rgba(255, 194, 209, 0) 62%);
}

.glow-pink {
  width: 180rpx;
  height: 180rpx;
  right: 60rpx;
  top: 100rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.55) 0%,
    rgba(255, 194, 209, 0.22) 33%,
    rgba(255, 194, 209, 0) 60%);
}

.eyebrow,
.hero-title,
.hero-sub {
  position: relative;
  z-index: 1;
}

.eyebrow {
  display: block;
  color: #E85A7A;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 14rpx;
  font-size: 62rpx;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: 1rpx;
  color: #2D1B24;
}

.hero-sub {
  display: block;
  margin-top: 20rpx;
  max-width: 460rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: rgba(45, 27, 36, 0.72);
}

.paper {
  position: relative;
  z-index: 1;
  margin: 24rpx 28rpx 0;
  padding: 48rpx 40rpx 40rpx;
  background: #FFFFFF;
  border-radius: 44rpx;
  box-shadow: 0 4rpx 16rpx rgba(45, 27, 36, 0.03), 0 24rpx 64rpx rgba(232, 90, 122, 0.10);
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #2D1B24;
}

.section-gap {
  margin-top: 12rpx;
}

.section-hint {
  display: block;
  margin: 10rpx 0 32rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: rgba(45, 27, 36, 0.62);
}

.field-block {
  margin-bottom: 32rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  color: rgba(45, 27, 36, 0.82);
}

.field-help {
  display: block;
  margin: -4rpx 0 14rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(45, 27, 36, 0.52);
}

.field {
  width: 100%;
  height: 92rpx;
  padding: 0 24rpx;
  background: #FFF5F7;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 194, 209, 0.45);
  font-size: 30rpx;
  color: #2D1B24;
}

.field-picker {
  line-height: 92rpx;
}

.textarea {
  width: 100%;
  height: 220rpx;
  padding: 20rpx 24rpx;
  background: #FFF5F7;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 194, 209, 0.45);
  font-size: 30rpx;
  line-height: 1.6;
  color: #2D1B24;
}

.textarea-short {
  height: 150rpx;
}

.ph {
  color: rgba(45, 27, 36, 0.38);
}

.counter {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  font-size: 24rpx;
  color: rgba(45, 27, 36, 0.42);
}

.choices {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.choice {
  display: inline-flex;
  align-items: center;
  margin: 0 16rpx 16rpx 0;
  padding: 8rpx 22rpx 8rpx 12rpx;
  border: 2rpx solid rgba(255, 194, 209, 0.55);
  border-radius: 999rpx;
  background: #FFF5F7;
  font-size: 26rpx;
  color: #2D1B24;
}

.choice.on {
  background: #FFC2D1;
  border-color: rgba(255, 138, 171, 0.55);
  box-shadow: 0 6rpx 16rpx rgba(232, 90, 122, 0.12);
}

.follow {
  margin-top: 8rpx;
}

.error {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #E85A7A;
}

.dim {
  opacity: 0.55;
}

.count-line,
.sample-note,
.privacy {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(45, 27, 36, 0.55);
}

.count-line {
  margin: 18rpx 8rpx 30rpx;
  text-align: center;
}

.sample-btn {
  margin-top: 8rpx;
}

.sample-note {
  margin: 16rpx 8rpx 8rpx;
}

.quiet {
  margin-top: 28rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.55);
  text-decoration: underline;
}

.privacy {
  margin-top: 28rpx;
}
