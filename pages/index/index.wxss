/* 填写页。
   底是一层弥散光，正文浮在上面。整页不再是一张空白表单，
   而是从「先认识你们」到「还有一页留给你」的四段小卡。 */

.page {
  position: relative;
  min-height: 100vh;
  padding-bottom: 240rpx;
}

/* 弥散底。只铺在页头这一段，下面留干净的奶油底给表单。 */
.ambient {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 780rpx;
  z-index: 0;
  overflow: hidden;
}

.amb-lower {
  top: 30%;
  bottom: -6%;
  opacity: 0.7;
}

/* 底边化开，让色和奶油底之间没有一条线。 */
.amb-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 320rpx;
  background: linear-gradient(180deg, rgba(255, 245, 247, 0) 0%, rgba(255, 245, 247, 0.92) 72%, #FFF5F7 100%);
}

.hero {
  position: relative;
  z-index: 1;
  padding: 56rpx 48rpx 36rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.eyebrow-row {
  display: flex;
  align-items: center;
}

/* 「我的」入口：右上角一枚安静的胶囊。 */
.me-entry {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.6);
  box-shadow: inset 0 0 0 2rpx rgba(255, 194, 209, 0.55);
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.72);
}

/* 小标记用一道渐变短条，不用圆点，整体更软。 */
.eyebrow-dot {
  width: 34rpx;
  height: 8rpx;
  margin-right: 16rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #FF8FAB 0%, #D6BCFF 60%, #FFC59B 100%);
}

.eyebrow {
  color: #E85A7A;
  font-size: 26rpx;
  letter-spacing: 4rpx;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 66rpx;
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: 1rpx;
  color: #2D1B24;
  text-shadow: 0 0 48rpx rgba(255, 138, 171, 0.42);
}

.hero-sub {
  display: block;
  margin-top: 22rpx;
  max-width: 520rpx;
  font-size: 30rpx;
  line-height: 1.7;
  color: rgba(45, 27, 36, 0.72);
}

/* 进度条。写了多少，看得见。 */
.progress {
  margin-top: 36rpx;
}

.progress-track {
  height: 10rpx;
  border-radius: 10rpx;
  background: rgba(255, 138, 171, 0.16);
  overflow: hidden;
}

.progress-fill {
  height: 10rpx;
  border-radius: 10rpx;
  background: linear-gradient(90deg, #FF8FAB 0%, #D6BCFF 55%, #FFC59B 100%);
  transition: width 260ms ease;
}

.progress-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(45, 27, 36, 0.5);
}

/* 正文那一大张磨砂纸。 */
.sheet {
  position: relative;
  z-index: 1;
  margin: 0 24rpx;
  padding: 12rpx 36rpx 44rpx;
  border-radius: 44rpx;
  background: rgba(255, 255, 255, 0.58);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.85),
    0 30rpx 70rpx rgba(45, 27, 36, 0.09);
}

.group {
  padding-top: 40rpx;
}

.group + .group {
  margin-top: 12rpx;
  border-top: 2rpx solid rgba(255, 138, 171, 0.13);
}

.group-head {
  display: flex;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.group-no {
  flex: none;
  margin-right: 20rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 171, 0.16);
  color: #E85A7A;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  line-height: 1.7;
}

.group-text {
  flex: 1;
}

.group-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D1B24;
}

.group-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: rgba(45, 27, 36, 0.5);
}

.field-block {
  margin-bottom: 34rpx;
}

.field-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.66);
}

.field-help {
  display: block;
  margin-bottom: 14rpx;
  font-size: 25rpx;
  line-height: 1.55;
  color: rgba(45, 27, 36, 0.48);
}

/* 单行输入只用一条底线，画面轻一点，也不再是一格一格的方框。 */
.field {
  width: 100%;
  height: 88rpx;
  padding: 0 4rpx;
  background: transparent;
  border: none;
  box-shadow: inset 0 -2rpx 0 rgba(255, 138, 171, 0.45);
  font-size: 32rpx;
  color: #2D1B24;
}

.field-picker {
  line-height: 88rpx;
}

/* 多行还是要一块地方，才放得下一段话。 */
.textarea {
  width: 100%;
  height: 200rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 245, 247, 0.9);
  border: none;
  border-radius: 24rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 194, 209, 0.5);
  font-size: 30rpx;
  line-height: 1.6;
  color: #2D1B24;
}

.textarea-short {
  height: 160rpx;
}

.ph {
  color: rgba(45, 27, 36, 0.34);
}

.counter {
  display: block;
  margin-top: 10rpx;
  text-align: right;
  font-size: 24rpx;
  color: rgba(45, 27, 36, 0.4);
}

.choices {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.choice {
  display: inline-flex;
  align-items: center;
  margin: 0 16rpx 16rpx 0;
  padding: 8rpx 22rpx 8rpx 12rpx;
  border: 2rpx solid rgba(255, 194, 209, 0.6);
  border-radius: 999rpx;
  background: rgba(255, 245, 247, 0.7);
  font-size: 26rpx;
  color: #2D1B24;
}

.choice.on {
  background: rgba(255, 138, 171, 0.22);
  border-color: rgba(255, 138, 171, 0.7);
  box-shadow: 0 6rpx 18rpx rgba(232, 90, 122, 0.12);
}

.follow {
  margin-top: 10rpx;
}

/* —— 一起去过的地方：一行输入 + 添加按钮，加好的城市变成一个个气泡。 —— */
.chips-input {
  display: flex;
  align-items: flex-end;
}

.chips-field {
  flex: 1;
}

.chips-add {
  flex: none;
  margin-left: 20rpx;
  margin-bottom: 22rpx;
  padding: 12rpx 32rpx;
  border: 2rpx solid rgba(255, 138, 171, 0.6);
  border-radius: 999rpx;
  background: rgba(255, 245, 247, 0.8);
  font-size: 26rpx;
  font-weight: 600;
  color: #E85A7A;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.chip {
  display: inline-flex;
  align-items: center;
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 16rpx 10rpx 24rpx;
  border: 2rpx solid rgba(255, 138, 171, 0.55);
  border-radius: 999rpx;
  background: rgba(255, 138, 171, 0.14);
}

.chip-text {
  font-size: 26rpx;
  color: #2D1B24;
}

.chip-x {
  margin-left: 12rpx;
  padding: 0 10rpx;
  font-size: 30rpx;
  line-height: 1;
  color: rgba(45, 27, 36, 0.45);
}

.error {
  display: block;
  margin-bottom: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  color: #E85A7A;
}

.dim {
  opacity: 0.55;
}

.tail {
  margin-top: 16rpx;
  padding-top: 36rpx;
  border-top: 2rpx solid rgba(255, 138, 171, 0.13);
}

.count-line,
.sample-note,
.privacy {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(45, 27, 36, 0.55);
}

.count-line {
  flex: 1;
  min-width: 0;
  font-size: 25rpx;
  line-height: 1.45;
}

.sample-btn {
  margin-top: 8rpx;
}

.sample-note {
  margin: 16rpx 8rpx 8rpx;
}

.quiet-row {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.quiet {
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.55);
  text-decoration: underline;
}

.quiet-sep {
  margin: 0 14rpx;
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.35);
}

.privacy {
  margin-top: 16rpx;
  text-align: center;
}

/* 底部固定操作条。按钮一直在手边，不用滑到最下面找。 */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 245, 247, 0.94);
  box-shadow: 0 -12rpx 32rpx rgba(45, 27, 36, 0.07);
}

.action-bar .btn {
  flex: none;
  width: 320rpx;
  margin-left: 24rpx;
}

/* —— 主题选择器。
   swatch 的颜色由 wxml 用 item.bg / item.accent 内联给出，
   这套样式只管布局和选中态。 —— */
.swatches {
  display: flex;
  flex-wrap: wrap;
}

.swatch {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 0 24rpx 20rpx 0;
  padding: 22rpx 26rpx 14rpx;
  border: 2rpx solid rgba(45, 27, 36, 0.08);
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.55);
  transition: transform 160ms ease;
}

.swatch.on {
  transform: translateY(-4rpx);
  background: rgba(255, 255, 255, 0.9);
}

.swatch-dot {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 8rpx solid transparent;
  box-sizing: border-box;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.9);
}

.swatch-label {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(45, 27, 36, 0.6);
}

.swatch.on .swatch-label {
  font-weight: 600;
  color: #2D1B24;
}

/* —— 其余主题的覆盖规则。色值与 utils/themes.js 一致。 —— */

.page {
  background: #FFF5F7;
}

.theme-matcha {
  background: #F2FAF4;
}

.theme-sky {
  background: #F1F6FD;
}

.theme-violet {
  background: #F7F4FC;
}

.theme-matcha .eyebrow {
  color: #2E8B62;
}

.theme-matcha .eyebrow-dot {
  background: linear-gradient(90deg, #8FD3A8 0%, #8FC7B9 60%, #F2E3A1 100%);
}

.theme-matcha .hero-title {
  color: #1E2B23;
  text-shadow: 0 0 48rpx rgba(143, 211, 168, 0.42);
}

.theme-matcha .progress-track {
  background: rgba(143, 211, 168, 0.16);
}

.theme-matcha .progress-fill {
  background: linear-gradient(90deg, #8FD3A8 0%, #8FC7B9 55%, #F2E3A1 100%);
}

.theme-matcha .group + .group,
.theme-matcha .tail {
  border-top-color: rgba(143, 211, 168, 0.13);
}

.theme-matcha .group-no {
  background: rgba(143, 211, 168, 0.18);
  color: #2E8B62;
}

.theme-matcha .field {
  box-shadow: inset 0 -2rpx 0 rgba(143, 211, 168, 0.5);
}

.theme-matcha .textarea {
  background: rgba(243, 250, 245, 0.9);
  box-shadow: inset 0 0 0 2rpx rgba(200, 233, 210, 0.55);
}

.theme-matcha .choice {
  border-color: rgba(200, 233, 210, 0.65);
  background: rgba(242, 250, 244, 0.8);
}

.theme-matcha .choice.on {
  background: rgba(143, 211, 168, 0.24);
  border-color: rgba(143, 211, 168, 0.75);
  box-shadow: 0 6rpx 18rpx rgba(46, 139, 98, 0.12);
}

.theme-matcha .action-bar {
  background: rgba(242, 250, 244, 0.94);
}

.theme-matcha .swatch.on .swatch-label {
  color: #1E2B23;
}

.theme-sky .eyebrow {
  color: #4A7DBF;
}

.theme-sky .eyebrow-dot {
  background: linear-gradient(90deg, #A3C4F1 0%, #B9A9F0 60%, #A9DAEA 100%);
}

.theme-sky .hero-title {
  color: #1C2A3C;
  text-shadow: 0 0 48rpx rgba(163, 196, 241, 0.42);
}

.theme-sky .progress-track {
  background: rgba(163, 196, 241, 0.16);
}

.theme-sky .progress-fill {
  background: linear-gradient(90deg, #A3C4F1 0%, #B9A9F0 55%, #A9DAEA 100%);
}

.theme-sky .group + .group,
.theme-sky .tail {
  border-top-color: rgba(163, 196, 241, 0.13);
}

.theme-sky .group-no {
  background: rgba(163, 196, 241, 0.18);
  color: #4A7DBF;
}

.theme-sky .field {
  box-shadow: inset 0 -2rpx 0 rgba(163, 196, 241, 0.5);
}

.theme-sky .textarea {
  background: rgba(243, 248, 253, 0.9);
  box-shadow: inset 0 0 0 2rpx rgba(207, 226, 248, 0.55);
}

.theme-sky .choice {
  border-color: rgba(207, 226, 248, 0.65);
  background: rgba(241, 246, 253, 0.8);
}

.theme-sky .choice.on {
  background: rgba(163, 196, 241, 0.24);
  border-color: rgba(163, 196, 241, 0.75);
  box-shadow: 0 6rpx 18rpx rgba(74, 125, 191, 0.12);
}

.theme-sky .action-bar {
  background: rgba(241, 246, 253, 0.94);
}

.theme-sky .swatch.on .swatch-label {
  color: #1C2A3C;
}

.theme-violet .eyebrow {
  color: #7B5BC8;
}

.theme-violet .eyebrow-dot {
  background: linear-gradient(90deg, #C9AFF2 0%, #E2A9E4 60%, #F5B8D0 100%);
}

.theme-violet .hero-title {
  color: #2B2144;
  text-shadow: 0 0 48rpx rgba(201, 175, 242, 0.42);
}

.theme-violet .progress-track {
  background: rgba(201, 175, 242, 0.16);
}

.theme-violet .progress-fill {
  background: linear-gradient(90deg, #C9AFF2 0%, #E2A9E4 55%, #F5B8D0 100%);
}

.theme-violet .group + .group,
.theme-violet .tail {
  border-top-color: rgba(201, 175, 242, 0.13);
}

.theme-violet .group-no {
  background: rgba(201, 175, 242, 0.18);
  color: #7B5BC8;
}

.theme-violet .field {
  box-shadow: inset 0 -2rpx 0 rgba(201, 175, 242, 0.5);
}

.theme-violet .textarea {
  background: rgba(249, 246, 253, 0.9);
  box-shadow: inset 0 0 0 2rpx rgba(228, 212, 250, 0.55);
}

.theme-violet .choice {
  border-color: rgba(228, 212, 250, 0.65);
  background: rgba(247, 244, 252, 0.8);
}

.theme-violet .choice.on {
  background: rgba(201, 175, 242, 0.24);
  border-color: rgba(201, 175, 242, 0.75);
  box-shadow: 0 6rpx 18rpx rgba(123, 91, 200, 0.12);
}

.theme-violet .action-bar {
  background: rgba(247, 244, 252, 0.94);
}

.theme-violet .swatch.on .swatch-label {
  color: #2B2144;
}

/* 主题下的添加按钮与城市气泡。 */
.theme-matcha .chips-add {
  border-color: rgba(143, 211, 168, 0.65);
  background: rgba(242, 250, 244, 0.8);
  color: #2E8B62;
}

.theme-matcha .chip {
  border-color: rgba(143, 211, 168, 0.6);
  background: rgba(143, 211, 168, 0.14);
}

.theme-sky .chips-add {
  border-color: rgba(163, 196, 241, 0.65);
  background: rgba(241, 246, 253, 0.8);
  color: #4A7DBF;
}

.theme-sky .chip {
  border-color: rgba(163, 196, 241, 0.6);
  background: rgba(163, 196, 241, 0.14);
}

.theme-violet .chips-add {
  border-color: rgba(201, 175, 242, 0.65);
  background: rgba(247, 244, 252, 0.8);
  color: #7B5BC8;
}

.theme-violet .chip {
  border-color: rgba(201, 175, 242, 0.6);
  background: rgba(201, 175, 242, 0.14);
}

.privacy-link {
  margin-top: 16rpx;
  text-decoration: underline;
  opacity: 0.75;
}
