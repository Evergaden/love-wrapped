<view class="stage theme-{{currentTheme}}" style="height: {{windowHeight}}px;">
  <view wx:if="{{empty}}" class="empty">
    <view class="mesh mesh-1" style="background-image: {{emptyMeshStyle}}"></view>
    <view class="mesh amb-lower" style="background-image: {{emptyLowerStyle}}"></view>
    <view class="bloom"></view>
    <view class="empty-inner">
      <view class="card">
        <view class="hairline"></view>
        <view class="kicker-row">
          <view class="kicker-bar"></view>
          <text class="kicker">{{appName}}</text>
        </view>
        <text class="title title-lg">这本纪念册还是空白的</text>
        <text class="body">先写下两个昵称，和你们在一起的日子。其余的可以以后再补。</text>
        <view class="btn btn-primary empty-btn" hover-class="pressed" bindtap="onGoFill">去填写</view>
        <view class="btn btn-ghost empty-btn" hover-class="pressed" bindtap="onUseSample">用示例看一看</view>
      </view>
    </view>
  </view>

  <block wx:else>
    <swiper
      class="swiper"
      style="height: {{swiperHeight}}px;"
      duration="320"
      easing-function="easeOutCubic"
      current="{{current}}"
      bindchange="onSwipe"
    >
      <swiper-item wx:for="{{slides}}" wx:key="id">
        <view class="slide theme-{{item.theme}} id-{{item.id}}" style="height: {{swiperHeight}}px;">
          <!-- 每一页各自铺一层弥散底，颜色由 themes.js 算好直接内联。 -->
          <view class="mesh {{item.mesh}}" style="background-image: {{item.meshStyle}}"></view>
          <view class="bloom"></view>
          <scroll-view scroll-y show-scrollbar="{{false}}" class="content" style="height: {{swiperHeight}}px;">
            <view class="content-inner theme-{{item.theme}}">
              <view class="card">
                <view class="hairline" style="background: {{item.hairStyle}}"></view>
                <view class="card-main">
                  <view class="kicker-row {{item.layout === 'journey' || item.layout === 'bubble' || item.layout === 'finale' ? 'centered' : ''}}">
                    <view class="kicker-bar"></view>
                    <text class="kicker">{{item.kicker}}</text>
                  </view>

                  <block wx:if="{{item.layout === 'cover'}}">
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.nameSize}}">{{item.nameA}}</text>
                  </view>
                  <view class="name-line">
                    <text class="and">和</text>
                    <view class="title-wrap">
                      <view class="title-glow"></view>
                      <text class="title title-{{item.nameSize}}">{{item.nameB}}</text>
                    </view>
                  </view>
                  <view class="pill">
                    <text class="pill-text">{{item.body}}</text>
                  </view>
                  <text class="meta meta-lg">{{item.meta}}</text>
                </block>

                  <block wx:elif="{{item.layout === 'numbers'}}">
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-md">{{item.title}}</text>
                  </view>
                  <view class="stats">
                    <view class="stat" wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label">
                      <view class="stat-line">
                        <text class="num">{{stat.num}}</text>
                        <text class="unit">{{stat.unit}}</text>
                      </view>
                      <text class="stat-label">{{stat.label}}</text>
                    </view>
                  </view>
                  <text class="note" wx:if="{{item.note}}">{{item.note}}</text>
                </block>

                  <!-- 拼图：去过的地方一块一块拼起来，最远的那块挂「最远」。 -->
                  <block wx:elif="{{item.layout === 'puzzle'}}">
                  <view class="tile-grid">
                    <view
                      class="tile {{index % 2 === 0 ? 'tile-lean-l' : 'tile-lean-r'}}"
                      wx:for="{{item.tiles}}"
                      wx:for-item="tile"
                      wx:key="name"
                      style="{{tile.bgStyle}}"
                    >
                      <text class="tile-name">{{tile.name}}</text>
                      <text class="tile-dist" wx:if="{{tile.dist}}">{{tile.dist}}</text>
                      <view class="tile-badge" wx:if="{{tile.far}}"><text class="tile-badge-text">最远</text></view>
                    </view>
                  </view>
                  <text class="meta puzzle-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <!-- 明信片：地点在左，日期缩成右上角的邮戳。 -->
                  <block wx:elif="{{item.layout === 'postcard'}}">
                  <view class="postcard-row">
                    <view class="title-wrap">
                      <view class="title-glow"></view>
                      <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                    </view>
                    <view class="stamp" wx:if="{{item.stamp}}" style="{{item.stampStyle}}">
                      <text class="stamp-year">{{item.stampTop}}</text>
                      <text class="stamp-day">{{item.stampBottom}}</text>
                    </view>
                  </view>
                  <text class="body" wx:if="{{item.body}}">{{item.body}}</text>
                  <text class="meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <!-- 旅程图：大数字压在一条虚线上，虚线两端各一个点。 -->
                  <block wx:elif="{{item.layout === 'journey'}}">
                  <view class="journey">
                    <view class="journey-num-row">
                      <text class="journey-num" style="font-size: {{item.journeyNumSize}}rpx">{{item.journeyNum}}</text>
                      <text class="journey-unit">{{item.journeyUnit}}</text>
                    </view>
                    <view class="journey-track">
                      <view class="journey-cap" style="{{item.journeyDot}}"></view>
                      <view class="journey-line" style="{{item.journeyLine}}"></view>
                      <view class="journey-cap" style="{{item.journeyDot}}"></view>
                    </view>
                    <text class="journey-label">{{item.journeyLabel}}</text>
                    <text class="meta journey-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                  </view>
                </block>

                  <!-- 气泡：那句口头禅装在一只气泡里。 -->
                  <block wx:elif="{{item.layout === 'bubble'}}">
                  <view class="bubble-wrap">
                    <view class="bubble" style="{{item.bubbleStyle}}">
                      <text class="bubble-mark" style="{{item.bubbleTextStyle}}">「</text>
                      <text class="bubble-text" style="{{item.bubbleTextStyle}}">{{item.title}}</text>
                      <text class="bubble-mark" style="{{item.bubbleTextStyle}}">」</text>
                    </view>
                    <view class="bubble-tail" style="{{item.bubbleTailStyle}}"></view>
                  </view>
                  <text class="body bubble-note" wx:if="{{item.body}}">{{item.body}}</text>
                </block>

                  <!-- 手记：左侧一道色条，正文首行缩进两个字。 -->
                  <block wx:elif="{{item.layout === 'letter'}}">
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                  </view>
                  <view class="letter-block">
                    <view class="letter-bar" style="{{item.letterBar}}"></view>
                    <text class="body letter-body">{{item.body}}</text>
                  </view>
                  <text class="meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <!-- 终章：整页居中，像扉页的题字。 -->
                  <block wx:elif="{{item.layout === 'finale'}}">
                  <view class="title-wrap finale-title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                  </view>
                  <text class="body finale-body" wx:if="{{item.body}}">{{item.body}}</text>
                  <text class="meta finale-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <block wx:else>
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                  </view>
                  <text class="body" wx:if="{{item.body}}">{{item.body}}</text>
                  <text class="meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                  </block>
                </view>

                <view class="sign">
                  <view class="sign-line"></view>
                  <text class="sign-text">{{item.footer}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </swiper-item>
    </swiper>

    <view class="dock">
      <view class="pager-row">
        <view class="dots">
          <view
            class="dot {{index === current ? 'on' : ''}}"
            wx:for="{{slides}}"
            wx:key="id"
          ></view>
        </view>
        <view class="pager-right">
          <text class="swipe-hint" wx:if="{{current === 0}}">向左滑</text>
          <text class="pager">{{current + 1}} / {{slides.length}}</text>
        </view>
      </view>
      <view class="theme-row">
        <text class="theme-row-label">配色</text>
        <view class="theme-dots">
          <view
            class="theme-dot {{currentTheme === item.id ? 'on' : ''}}"
            wx:for="{{themeList}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapTheme"
            style="background: {{item.accent}}"
            aria-role="button"
            aria-label="{{item.label}}配色"
          ></view>
        </view>
      </view>
      <view class="dock-actions">
        <view class="btn btn-ghost" hover-class="pressed" bindtap="onExport">导出此页</view>
        <view class="btn btn-primary" hover-class="pressed" bindtap="onExportAll">导出整本</view>
      </view>
      <view class="dock-share">
        <button class="btn btn-share" hover-class="pressedShare" open-type="share">分享给 TA</button>
      </view>
      <!-- 礼物模式：这册是转发带来的，字都装在链接里。可以收下，也可以自己写一本。 -->
      <view class="dock-tip gift-tip" wx:if="{{gift}}">
        <text>这册纪念册是转发带来的，字都装在链接里，从一部手机直达另一部，没经过任何服务器。</text>
        <view class="gift-cta-row">
          <text class="gift-cta" hover-class="pressed" bindtap="onSaveGift" aria-role="button">把这册留在我手机上</text>
          <text class="gift-cta gift-cta-quiet" hover-class="pressed" bindtap="onGoFill" aria-role="button">我也写一本 →</text>
        </view>
      </view>
    </view>
  </block>
</view>

<!-- 画布放在屏幕外。用户看到的是导出后的图片，不是这块画布。 -->
<canvas
  type="2d"
  id="poster"
  class="poster-canvas"
  style="width: {{canvasW}}px; height: {{canvasH}}px;"
></canvas>

<!-- 分享封面用的画布。同样放在屏幕外，只用来生成转发卡片上的图。 -->
<canvas
  type="2d"
  id="share"
  class="share-canvas"
  style="width: 750px; height: 600px;"
></canvas>

<view class="mask" wx:if="{{sheet}}" bindtap="onCloseSheet" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <text class="sheet-kicker">预览</text>
    <text class="sheet-title">{{sheet.title}}</text>
    <scroll-view scroll-y class="sheet-scroll">
      <image class="sheet-img" src="{{sheet.path}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
    </scroll-view>
    <text class="sheet-tip">长按图片可以直接保存到手机，也可以点下面的按钮。</text>
    <view class="sheet-actions">
      <view class="btn btn-ghost" hover-class="pressed" bindtap="onPreviewImage">查看大图</view>
      <view class="btn btn-primary" hover-class="pressed" bindtap="onSaveAlbum">存到相册</view>
    </view>
    <view class="sheet-share" wx:if="{{canShareImage}}">
      <view class="btn btn-ghost" hover-class="pressed" bindtap="onShareImage" aria-role="button">直接发送给朋友</view>
    </view>
    <view class="sheet-close" hover-class="pressed" bindtap="onCloseSheet">关闭</view>
  </view>
</view>
