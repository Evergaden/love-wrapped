<view class="stage theme-{{currentTheme}}" style="height: {{windowHeight}}px;">
  <view wx:if="{{empty}}" class="empty">
    <view class="mesh mesh-1" style="background-image: {{emptyMeshStyle}}"></view>
    <view class="mesh amb-lower" style="background-image: {{emptyLowerStyle}}"></view>
    <view class="bloom"></view>
    <view class="empty-inner">
      <view class="card">
        <view class="hairline"></view>
        <view class="kicker-row">
          <view class="kicker-bar"></view>
          <text class="kicker">{{appName}}</text>
        </view>
        <text class="title title-lg">这本纪念册还是空白的</text>
        <text class="body">先写下两个昵称，和你们在一起的日子。其余的可以以后再补。</text>
        <view class="btn btn-primary empty-btn" hover-class="pressed" bindtap="onGoFill">去填写</view>
        <view class="btn btn-ghost empty-btn" hover-class="pressed" bindtap="onUseSample">用示例看一看</view>
      </view>
    </view>
  </view>

  <!-- 礼物模式：正在取回答案（令牌还在拉数据） -->
  <view wx:elif="{{giftState === 'loading' && giftFetching}}" class="empty">
    <view class="mesh mesh-1" style="background-image: {{emptyMeshStyle}}"></view>
    <view class="mesh amb-lower" style="background-image: {{emptyLowerStyle}}"></view>
    <view class="bloom"></view>
    <view class="empty-inner">
      <view class="fetch-dots">
        <text class="fetch-dot d1">♥</text>
        <text class="fetch-dot d2">♥</text>
        <text class="fetch-dot d3">♥</text>
      </view>
      <text class="fetch-text">正在取回礼物…</text>
    </view>
  </view>

  <!-- 礼物模式：数据已取回，正在拆封 -->
  <view wx:elif="{{giftState === 'loading'}}" class="empty">
    <view class="mesh mesh-1" style="background-image: {{emptyMeshStyle}}"></view>
    <view class="mesh amb-lower" style="background-image: {{emptyLowerStyle}}"></view>
    <view class="bloom"></view>
    <view class="empty-inner">
      <!-- 拆信封：翻盖打开 → 信纸升起 → 小心心飘出，循环播放，配色跟主题走 -->
      <view class="env-stage">
        <view class="env-hearts">
          <text class="env-heart h1">♥</text>
          <text class="env-heart h2">♥</text>
          <text class="env-heart h3">♥</text>
        </view>
        <view class="env">
          <view class="env-back"></view>
          <view class="env-letter">
            <view class="env-line env-line-1"></view>
            <view class="env-line env-line-2"></view>
            <text class="env-letter-heart">♥</text>
          </view>
          <view class="env-front"></view>
          <view class="env-flap"></view>
        </view>
        <view class="env-shadow"></view>
      </view>
      <view class="card">
        <view class="hairline"></view>
        <view class="kicker-row">
          <view class="kicker-bar"></view>
          <text class="kicker">{{appName}}</text>
        </view>
        <text class="title title-lg">正在拆开这册纪念册…</text>
        <text class="body">TA 写的字正在路上。</text>
      </view>
    </view>
  </view>

  <!-- 拆封前的全屏封面：标题是分享者起的，点「立即开启」才拆。 -->
  <view wx:elif="{{giftState === 'splash'}}" class="gift-splash">
    <view class="mesh mesh-1" style="background-image: {{emptyMeshStyle}}"></view>
    <view class="mesh amb-lower" style="background-image: {{emptyLowerStyle}}"></view>
    <view class="bloom"></view>
    <view class="splash-hearts">
      <text class="splash-heart h1">♥</text>
      <text class="splash-heart h2">♥</text>
      <text class="splash-heart h3">♥</text>
    </view>
    <view class="splash-inner">
      <text class="splash-title">{{giftSplashTitle}}</text>
      <text class="splash-sub">来自 {{giftFrom}} 的一册纪念册</text>
      <text class="splash-date" wx:if="{{giftDateText}}">{{giftDateText}}</text>
    </view>
    <view class="splash-cta" hover-class="splash-cta-press" bindtap="onOpenGift" aria-role="button">
      <text class="splash-cta-text">立即开启</text>
    </view>
  </view>

  <view wx:elif="{{giftState === 'error'}}" class="empty">
    <view class="mesh mesh-1" style="background-image: {{emptyMeshStyle}}"></view>
    <view class="mesh amb-lower" style="background-image: {{emptyLowerStyle}}"></view>
    <view class="bloom"></view>
    <view class="empty-inner">
      <view class="card">
        <view class="hairline"></view>
        <view class="kicker-row">
          <view class="kicker-bar"></view>
          <text class="kicker">{{appName}}</text>
        </view>
        <text class="title title-lg">这册打不开</text>
        <text class="body">{{giftError}}</text>
        <view class="btn btn-primary empty-btn" hover-class="pressed" bindtap="onGoFill">去写一本</view>
      </view>
    </view>
  </view>

  <block wx:else>
    <swiper
      class="swiper"
      style="height: {{swiperHeight}}px;"
      duration="320"
      easing-function="easeOutCubic"
      current="{{current}}"
      bindchange="onSwipe"
    >
      <swiper-item wx:for="{{slides}}" wx:key="id">
        <view class="slide theme-{{item.theme}} id-{{item.id}} {{pageIn === index ? 'page-in' : ''}}" style="height: {{swiperHeight}}px;">
          <!-- 每一页各自铺一层弥散底，颜色由 themes.js 算好直接内联。 -->
          <view class="mesh {{item.mesh}}" style="background-image: {{item.meshStyle}}"></view>
          <view class="bloom"></view>
          <scroll-view scroll-y show-scrollbar="{{false}}" class="content" style="height: {{swiperHeight}}px;">
            <view class="content-inner theme-{{item.theme}}">
              <view class="card">
                <view class="hairline" style="background: {{item.hairStyle}}"></view>
                <view class="card-main">
                  <view class="kicker-row {{item.layout === 'journey' || item.layout === 'bubble' || item.layout === 'award' || item.layout === 'fight' || item.layout === 'finale' ? 'centered' : ''}}">
                    <view class="kicker-bar"></view>
                    <text class="kicker">{{item.kicker}}</text>
                  </view>

                  <block wx:if="{{item.layout === 'cover'}}">
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <view class="cover-names {{item.coverOneLine ? 'cover-oneline' : ''}}">
                      <text class="title title-{{item.nameSize}}">{{item.nameA}}</text>
                      <text class="and">和</text>
                      <text class="title title-{{item.nameSize}}">{{item.nameB}}</text>
                    </view>
                  </view>
                  <view class="pill">
                    <text class="pill-text">{{item.body}}</text>
                  </view>
                  <text class="meta meta-lg">{{item.meta}}</text>
                </block>

                  <block wx:elif="{{item.layout === 'numbers'}}">
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-md">{{item.title}}</text>
                  </view>
                  <view class="stats">
                    <view class="stat" wx:for="{{item.stats}}" wx:for-item="stat" wx:key="label">
                      <view class="stat-line">
                        <text class="num">{{stat.num}}</text>
                        <text class="unit">{{stat.unit}}</text>
                      </view>
                      <text class="stat-label">{{stat.label}}</text>
                    </view>
                  </view>
                  <text class="note" wx:if="{{item.note}}">{{item.note}}</text>
                </block>

                  <!-- 拼图：去过的地方一块一块拼起来，最远的那块挂「最远」。 -->
                  <block wx:elif="{{item.layout === 'puzzle'}}">
                  <view class="tile-grid">
                    <view
                      class="tile {{index % 2 === 0 ? 'tile-lean-l' : 'tile-lean-r'}}"
                      wx:for="{{item.tiles}}"
                      wx:for-item="tile"
                      wx:key="name"
                      style="{{tile.bgStyle}}"
                    >
                      <text class="tile-name">{{tile.name}}</text>
                      <text class="tile-dist" wx:if="{{tile.dist}}">{{tile.dist}}</text>
                      <view class="tile-badge" wx:if="{{tile.far}}"><text class="tile-badge-text">最远</text></view>
                    </view>
                  </view>
                  <text class="meta puzzle-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <!-- 明信片：地点在左，日期缩成右上角的邮戳。 -->
                  <block wx:elif="{{item.layout === 'postcard'}}">
                  <view class="postcard-row">
                    <view class="title-wrap">
                      <view class="title-glow"></view>
                      <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                    </view>
                    <view class="stamp" wx:if="{{item.stamp}}" style="{{item.stampStyle}}">
                      <text class="stamp-year">{{item.stampTop}}</text>
                      <text class="stamp-day">{{item.stampBottom}}</text>
                    </view>
                  </view>
                  <text class="body" wx:if="{{item.body}}">{{item.body}}</text>
                  <text class="meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <!-- 旅程图：大数字压在一条虚线上，虚线两端各一个点。 -->
                  <block wx:elif="{{item.layout === 'journey'}}">
                  <view class="journey">
                    <view class="journey-num-row">
                      <text class="journey-num" style="font-size: {{item.journeyNumSize}}rpx">{{item.journeyNum}}</text>
                      <text class="journey-unit">{{item.journeyUnit}}</text>
                    </view>
                    <view class="journey-track">
                      <view class="journey-cap" style="{{item.journeyDot}}"></view>
                      <view class="journey-line" style="{{item.journeyLine}}"></view>
                      <view class="journey-cap" style="{{item.journeyDot}}"></view>
                    </view>
                    <text class="journey-label">{{item.journeyLabel}}</text>
                    <text class="meta journey-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                  </view>
                </block>

                  <!-- 气泡：那句口头禅装在一只气泡里。 -->
                  <block wx:elif="{{item.layout === 'bubble'}}">
                  <view class="bubble-wrap">
                    <view class="bubble" style="{{item.bubbleStyle}}">
                      <text class="bubble-text" style="{{item.bubbleTextStyle}}"><text class="bubble-mark" style="{{item.bubbleMarkStyle}}">「</text>{{item.title}}<text class="bubble-mark" style="{{item.bubbleMarkStyle}}">」</text></text>
                    </view>
                    <view class="bubble-tail" style="{{item.bubbleTailStyle}}"></view>
                  </view>
                  <text class="body bubble-note" wx:if="{{item.body}}">{{item.body}}</text>
                </block>

                  <!-- 手记：左侧一道色条，正文首行缩进两个字。 -->
                  <block wx:elif="{{item.layout === 'letter'}}">
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                  </view>
                  <view class="letter-block">
                    <view class="letter-bar" style="{{item.letterBar}}"></view>
                    <text class="body letter-body">{{item.body}}</text>
                  </view>
                  <text class="meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <!-- 获得的评价：像游戏成就，按 S/A/B 颁发，倒数第二页。 -->
                  <block wx:elif="{{item.layout === 'award'}}">
                  <view class="award-badge" style="background: {{item.tierColor}}">
                    <text class="award-badge-text">{{item.tierLabel}}</text>
                  </view>
                  <view class="title-wrap award-title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-xl">{{item.title}}</text>
                  </view>
                  <text class="body award-reason">{{item.reason}}</text>
                </block>

                  <!-- 爱吃的东西：一人一张小卡。 -->
                  <block wx:elif="{{item.layout === 'fave'}}">
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-lg">{{item.title}}</text>
                  </view>
                  <view class="fave-cards">
                    <view class="fave-card" wx:for="{{item.cards}}" wx:for-item="card" wx:key="cap" style="{{card.bgStyle}}">
                      <text class="fave-card-cap">{{card.cap}}</text>
                      <text class="fave-card-text {{card.empty ? 'fave-card-empty' : ''}}">{{card.text}}</text>
                    </view>
                  </view>
                  <text class="meta fave-meta">{{item.meta}}</text>
                </block>

                  <!-- 终章：整页居中，像扉页的题字。 -->
                  <block wx:elif="{{item.layout === 'finale'}}">
                  <view class="title-wrap finale-title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                  </view>
                  <text class="body finale-body" wx:if="{{item.body}}">{{item.body}}</text>
                  <text class="meta finale-meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                </block>

                  <block wx:elif="{{item.layout === 'fight'}}">
                  <view class="title-wrap fight-title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                  </view>
                  <view class="fight-chips">
                    <view class="fight-chip" wx:for="{{item.chips}}" wx:for-item="chip" wx:key="text" style="{{chip.bgStyle}}">
                      <text class="fight-chip-text">{{chip.text}}</text>
                    </view>
                  </view>
                  <text class="body fight-meta">{{item.meta}}</text>
                </block>

                  <block wx:else>
                  <view class="title-wrap">
                    <view class="title-glow"></view>
                    <text class="title title-{{item.titleSize}}">{{item.title}}</text>
                  </view>
                  <text class="body" wx:if="{{item.body}}">{{item.body}}</text>
                  <text class="meta" wx:if="{{item.meta}}">{{item.meta}}</text>
                  </block>
                </view>

                <view class="sign">
                  <view class="sign-line"></view>
                  <text class="sign-text">{{item.footer}}</text>
                </view>
              </view>
            </view>
          </scroll-view>
        </view>
      </swiper-item>
    </swiper>

    <view class="dock">
      <view class="pager-row">
        <view class="dots">
          <view
            class="dot {{index === current ? 'on' : ''}}"
            wx:for="{{slides}}"
            wx:key="id"
          ></view>
        </view>
        <view class="pager-right">
          <text class="swipe-hint" wx:if="{{current === 0}}">向左滑</text>
          <text class="pager">{{current + 1}} / {{slides.length}}</text>
        </view>
      </view>
      <!-- 配色只给作者用：收礼的人看 TA 选好的配色，不换。 -->
      <view class="theme-row" wx:if="{{!gift}}">
        <text class="theme-row-label">配色</text>
        <view class="theme-dots">
          <view
            class="theme-dot {{currentTheme === item.id ? 'on' : ''}}"
            wx:for="{{themeList}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapTheme"
            style="background: {{item.accent}}"
            aria-role="button"
            aria-label="{{item.label}}配色"
          ></view>
        </view>
      </view>
      <view class="dock-actions" wx:if="{{!gift}}">
        <view class="btn btn-ghost" hover-class="pressed" bindtap="onExportChoose">导出</view>
        <button class="btn btn-share" hover-class="pressedShare" bindtap="onOpenShareSheet" aria-role="button">分享给 TA</button>
      </view>
      <!-- 礼物视角：这册是 TA 写的。收进自己的历史，或者自己去做一本。 -->
      <view class="dock-tip gift-tip" wx:if="{{gift}}">
        <text>这册纪念册是 TA 写给你的。</text>
        <view class="gift-cta-row">
          <text class="gift-cta" wx:if="{{!giftSaved}}" hover-class="pressed" bindtap="onSaveGift" aria-role="button">收进我的历史</text>
          <text class="gift-cta gift-cta-done" wx:else>已收进历史 ✓</text>
          <text class="gift-cta gift-cta-quiet" hover-class="pressed" bindtap="onGoFill" aria-role="button">我也去做一本 →</text>
        </view>
      </view>
    </view>
  </block>
</view>

<!-- 画布放在屏幕外。用户看到的是导出后的图片，不是这块画布。 -->
<canvas
  type="2d"
  id="poster"
  class="poster-canvas"
  style="width: {{canvasW}}px; height: {{canvasH}}px;"
></canvas>

<!-- 分享封面用的画布。同样放在屏幕外，只用来生成转发卡片上的图。 -->
<canvas
  type="2d"
  id="share"
  class="share-canvas"
  style="width: 750px; height: 600px;"
></canvas>

<view class="mask" wx:if="{{sheet}}" bindtap="onCloseSheet" catchtouchmove="noop">
  <view class="sheet" catchtap="noop">
    <text class="sheet-kicker">预览</text>
    <text class="sheet-title">{{sheet.title}}</text>
    <scroll-view scroll-y class="sheet-scroll">
      <image class="sheet-img" src="{{sheet.path}}" mode="widthFix" show-menu-by-longpress="{{true}}" />
    </scroll-view>
    <text class="sheet-tip">长按图片可以直接保存到手机，也可以点下面的按钮。</text>
    <view class="sheet-actions">
      <view class="btn btn-ghost" hover-class="pressed" bindtap="onPreviewImage">查看大图</view>
      <view class="btn btn-primary" hover-class="pressed" bindtap="onSaveAlbum">存到相册</view>
    </view>
    <view class="sheet-share" wx:if="{{canShareImage}}">
      <view class="btn btn-ghost" hover-class="pressed" bindtap="onShareImage" aria-role="button">直接发送给朋友</view>
    </view>
    <view class="sheet-close" hover-class="pressed" bindtap="onCloseSheet">关闭</view>
  </view>
</view>

<!-- 分享面板：起个标题再发出去，对方拆封时就会看到这句话。 -->
<view class="share-mask theme-{{currentTheme}}" wx:if="{{shareSheetOpen}}" bindtap="onCloseShareSheet">
  <view class="share-sheet" catchtap="noop">
    <text class="share-sheet-title">给这份礼物起个标题</text>
    <input
      class="share-sheet-input"
      maxlength="24"
      placeholder="会印在卡片上，比如：一周年快乐"
      placeholder-class="ph"
      value="{{shareTitleInput}}"
      bindinput="onShareTitleInput"
    />
    <view class="share-chips">
      <view
        class="share-chip {{shareTitleInput === chip ? 'share-chip-on' : ''}}"
        wx:for="{{shareChips}}"
        wx:for-item="chip"
        wx:key="*this"
        bindtap="onShareChip"
        data-title="{{chip}}"
      >{{chip}}</view>
    </view>
    <button class="share-go" open-type="share">发给 TA</button>
    <view class="share-cancel" bindtap="onCloseShareSheet" aria-role="button">取消</view>
  </view>
</view>
