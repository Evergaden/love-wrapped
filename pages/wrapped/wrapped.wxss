/* 纪念册。每一页铺一层弥散光，正文浮在一块磨砂卡上。
   奶油底 #FFF5F7，粉 #FF8FAB、#FFC2D1，字 #2D1B24。
   蜜桃 #FFB583、薰衣草 #B79CFF 只出现在弥散底和卡面上，
   导出图片的同色在 utils/poster.js 里，改颜色时三处一起改。 */

.stage {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.theme-cream {
  background: #FFF5F7;
  color: #2D1B24;
}


.swiper {
  width: 100%;
}

.slide {
  position: relative;
  overflow: hidden;
}

.content {
  position: relative;
  z-index: 1;
}

/* 卡片撑满整页：外圈只留一圈窄边给弥散底，
   短的一页也不会吊在中间、上下空一大片。 */
.content-inner {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 28rpx 36rpx 32rpx;
}

.card {
  position: relative;
  flex: 1 0 auto;
  display: flex;
  flex-direction: column;
  padding: 48rpx 44rpx 44rpx;
  border-radius: 40rpx;
  /* 卡面压得薄一点，让底下的弥散能透上来，空白处就不是死白。 */
  background: rgba(255, 255, 255, 0.40);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.72),
    0 26rpx 60rpx rgba(45, 27, 36, 0.12);
}

/* 卡里的正文占满剩下的高度，上下居中；落款钉在最下面。 */
.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}







/* 卡口那道渐变细线。往里缩一点，避开圆角，才不会在拐角处翘出卡外。 */
.hairline {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  top: 0;
  height: 6rpx;
}

.kicker-row {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
}

.kicker-bar {
  width: 30rpx;
  height: 8rpx;
  margin-right: 14rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #FF8FAB 0%, #B79CFF 100%);
}

.kicker {
  display: block;
  font-size: 26rpx;
  letter-spacing: 6rpx;
}

.theme-cream .kicker {
  color: #E85A7A;
}

/* 标题浸在一团光里。光色随主题走：主色 a 的三层化开。 */
.title-wrap {
  position: relative;
}

.title-glow {
  position: absolute;
  left: -110rpx;
  right: -110rpx;
  top: -80rpx;
  bottom: -64rpx;
  pointer-events: none;
  background: radial-gradient(ellipse at 26% 50%,
    rgba(255, 138, 171, 0.24) 0%,
    rgba(255, 138, 171, 0.07) 48%,
    rgba(255, 138, 171, 0) 76%);
}

.theme-matcha .title-glow {
  background: radial-gradient(ellipse at 26% 50%,
    rgba(143, 211, 168, 0.24) 0%,
    rgba(143, 211, 168, 0.07) 48%,
    rgba(143, 211, 168, 0) 76%);
}

.theme-sky .title-glow {
  background: radial-gradient(ellipse at 26% 50%,
    rgba(163, 196, 241, 0.24) 0%,
    rgba(163, 196, 241, 0.07) 48%,
    rgba(163, 196, 241, 0) 76%);
}

.theme-violet .title-glow {
  background: radial-gradient(ellipse at 26% 50%,
    rgba(201, 175, 242, 0.24) 0%,
    rgba(201, 175, 242, 0.07) 48%,
    rgba(201, 175, 242, 0) 76%);
}

.title {
  position: relative;
  display: block;
  font-weight: 600;
  line-height: 1.28;
  word-break: break-all;
}

.title-xl { font-size: 72rpx; }
.title-lg { font-size: 60rpx; }
.title-md { font-size: 48rpx; }
.title-sm { font-size: 40rpx; }

.theme-cream .title,
.theme-cream .num,
.theme-cream .unit {
  color: #2D1B24;
  text-shadow: 0 4rpx 26rpx rgba(232, 90, 122, 0.18);
}

.name-line {
  display: flex;
  align-items: flex-end;
  margin-top: 10rpx;
}

.and {
  margin-right: 14rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  color: #FF8FAB;
}

/* 封面名字：短名一行居中（和 字小一号、主题色），长名两行堆叠。 */
.cover-names {
  display: flex;
  align-items: baseline;
  justify-content: center;
  flex-wrap: wrap;
}

.cover-names.cover-oneline {
  justify-content: center;
}

.cover-names .and {
  margin: 0 14rpx;
}

.id-cover .card-main {
  align-items: center;
  text-align: center;
}

.id-cover .title-wrap {
  width: 100%;
}

.id-cover .pill {
  align-self: center;
}

.id-cover .meta {
  text-align: center;
}

/* 封面上的日期小胶囊。 */
.pill {
  display: inline-block;
  margin-top: 38rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 171, 0.16);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.75);
}

.pill-text {
  font-size: 27rpx;
  color: #E85A7A;
}

.body,
.meta,
.note,
.stat-label {
  display: block;
}

.body {
  margin-top: 34rpx;
  font-size: 32rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.meta {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.meta-lg {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.theme-cream .body,
.theme-cream .meta,
.theme-cream .note,
.theme-cream .stat-label {
  color: rgba(45, 27, 36, 0.72);
}

.theme-cream .meta-lg {
  color: #2D1B24;
}

/* 数字页：每个数一张小卡，两行排开。 */
.stats {
  margin-top: 40rpx;
}

.stat {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.46);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72);
}

.stat-line {
  display: flex;
  align-items: baseline;
  flex: none;
}

.num {
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1;
}

.unit {
  margin-left: 8rpx;
  font-size: 26rpx;
}

.stat-label {
  margin-top: 0;
  /* 占满数字之外的剩余宽度：节日句子（如「正好是你们的第 3 个立冬」）
     要整句排在一行，折行吊在下面会显得没对齐。 */
  flex: 1;
  margin-left: 24rpx;
  text-align: right;
  font-size: 27rpx;
}

.note {
  margin-top: 36rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 落款。 */
.sign {
  margin-top: 44rpx;
}

.sign-line {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(45, 27, 36, 0.16), rgba(45, 27, 36, 0));
}

.sign-text {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(45, 27, 36, 0.42);
}

.dock {
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.theme-cream .dock {
  background: rgba(255, 245, 247, 0.94);
  box-shadow: 0 -10rpx 26rpx rgba(45, 27, 36, 0.05);
}

.pager-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 40rpx 0;
}

/* 进度用一道道短条，不用圆点。 */
.dots {
  display: flex;
  align-items: center;
}

.dot {
  width: 18rpx;
  height: 6rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
  background: rgba(45, 27, 36, 0.14);
  transition: width 200ms ease, background 200ms ease;
}

.dot.on {
  width: 44rpx;
  background: linear-gradient(90deg, #FF8FAB 0%, #B79CFF 100%);
}

.pager-right {
  display: flex;
  align-items: baseline;
}

.pager {
  font-size: 26rpx;
}

.swipe-hint {
  margin-right: 16rpx;
  font-size: 26rpx;
  opacity: 0.7;
}

.dock-actions {
  display: flex;
  padding: 16rpx 32rpx 0;
}

.dock-actions .btn {
  flex: 1;
}

.dock-actions .btn + .btn {
  margin-left: 16rpx;
}

/* 分享按钮。和「导出」并排一行，做成一支「邮票」的样式：
   深色底，和左边浅色的导出按钮区分开。 */

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #2D1B24;
  color: #FFF5F7;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(45, 27, 36, 0.22);
}

.btn-share::after {
  border: none;
}

.pressedShare {
  opacity: 0.86;
  transform: scale(0.985);
}

/* 底部那句说明。礼物模式下换成说明 +「我也写一本」的入口。 */
.dock-tip {
  padding: 14rpx 40rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.5;
}

.gift-tip .gift-cta {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.theme-cream .dock-tip {
  color: rgba(45, 27, 36, 0.46);
}

.empty {
  position: relative;
  height: 100%;
  overflow: hidden;
}

.amb-lower {
  top: 46%;
  bottom: -8%;
  opacity: 0.7;
}

.empty-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 48rpx 40rpx 64rpx;
}

/* 空状态那张卡按内容大小居中就好，不用撑满。 */
.empty-inner .card {
  flex: none;
  margin: auto 0;
}

.empty-btn {
  margin-top: 24rpx;
}

.empty-inner .body {
  margin-bottom: 34rpx;
}

.poster-canvas {
  position: fixed;
  left: -8000px;
  top: 0;
  pointer-events: none;
}

/* 分享封面用的画布，同样挪出屏幕，否则会压住 dock。 */
.share-canvas {
  position: fixed;
  left: -8000px;
  top: 0;
  pointer-events: none;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(45, 27, 36, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFF5F7;
  border-radius: 36rpx 36rpx 0 0;
}

.sheet-kicker {
  display: block;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #E85A7A;
}

.sheet-title {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #2D1B24;
}

.sheet-scroll {
  max-height: 52vh;
  margin: 20rpx 0 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.sheet-img {
  width: 100%;
  display: block;
}

.sheet-tip {
  display: block;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(45, 27, 36, 0.66);
}

.sheet-actions {
  display: flex;
}

.sheet-actions .btn {
  flex: 1;
}

.sheet-actions .btn + .btn {
  margin-left: 16rpx;
}

.sheet-close {
  margin-top: 18rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(45, 27, 36, 0.55);
}

/* —— 每页专属排版。
   装饰的颜色（邮戳、虚线、色条、气泡）由 slides.js 按主题算好内联在节点上，
   文字颜色沿用上面的 .theme-* 规则。 —— */

/* 居中排版的 kicker。 */
.kicker-row.centered {
  justify-content: center;
}

.kicker-row.centered .kicker-bar {
  display: none;
}

/* 明信片：标题在左，邮戳缩在右上角。 */
.postcard-row {
  display: flex;
  align-items: flex-start;
}

.postcard-row .title-wrap {
  flex: 1;
  min-width: 0;
}

.stamp {
  flex: none;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 132rpx;
  margin-left: 20rpx;
  border: 2rpx dashed currentColor;
  border-radius: 50%;
  transform: rotate(-6deg);
}

.stamp-year {
  font-size: 20rpx;
  letter-spacing: 2rpx;
}

.stamp-day {
  margin-top: 4rpx;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

/* 旅程图：大数字压在一条虚线上。 */
.journey {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.journey-num-row {
  display: flex;
  align-items: baseline;
}

.journey-num {
  font-size: 150rpx;
  font-weight: 600;
  line-height: 1.1;
  text-shadow: 0 4rpx 26rpx rgba(45, 27, 36, 0.12);
}

.journey-unit {
  margin-left: 12rpx;
  font-size: 30rpx;
}

.journey-track {
  display: flex;
  align-items: center;
  align-self: stretch;
  padding: 0 44rpx;
  margin-top: 30rpx;
}

.journey-cap {
  flex: none;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.journey-line {
  flex: 1;
  height: 0;
  margin: 0 10rpx;
  border-top: 3rpx dashed currentColor;
  opacity: 0.85;
}

.journey-label {
  margin-top: 30rpx;
  font-size: 30rpx;
  line-height: 1.6;
  text-align: center;
}

.journey-meta {
  margin-top: 10rpx;
  text-align: center;
}

/* 气泡：口头禅装在里面，尾巴朝下。 */
.bubble-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bubble {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: center;
  align-self: stretch;
  padding: 30rpx 36rpx 34rpx;
  border-radius: 30rpx;
}

.bubble-mark {
  font-size: 46rpx;
  font-weight: 600;
}

.bubble-text {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.45;
  text-align: center;
}

.bubble-tail {
  width: 0;
  height: 0;
  margin-top: -2rpx;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 18rpx solid transparent;
}

.bubble-note {
  margin-top: 34rpx;
  text-align: center;
}

/* 手记：左侧一道色条，正文首行缩进。 */
.letter-block {
  display: flex;
  align-items: stretch;
  margin-top: 34rpx;
}

.letter-bar {
  flex: none;
  width: 6rpx;
  margin-right: 24rpx;
  border-radius: 6rpx;
}

.letter-body {
  flex: 1;
  text-indent: 2em;
}

/* 终章：整页居中。 */
.finale-title-wrap {
  text-align: center;
}

.finale-title-wrap .title {
  text-align: center;
}

.finale-body {
  text-align: center;
  letter-spacing: 2rpx;
}

.finale-meta {
  text-align: center;
  letter-spacing: 4rpx;
}

/* —— 拼图页：去过的地方一块一块拼起来。
   块的底色由 slides.js 按主题内联，左右两列各自歪一点点，
   像随手拼上去的。最远的那块右上角挂一枚「最远」。 —— */
.tile-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 10rpx;
}

.tile {
  position: relative;
  width: calc(50% - 26rpx);
  margin: 12rpx;
  padding: 26rpx 28rpx;
  border-radius: 30rpx;
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.55);
}

.tile-lean-l {
  transform: rotate(-1.4deg);
}

.tile-lean-r {
  transform: rotate(1.2deg);
}

.tile-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.tile-dist {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.72;
}

.tile-badge {
  position: absolute;
  left: 50%;
  top: -16rpx;
  transform: translateX(-50%);
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: #E85A7A;
  box-shadow: 0 4rpx 12rpx rgba(232, 90, 122, 0.35);
}

.tile-badge-text {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  color: #FFF5F7;
}

.puzzle-meta {
  margin-top: 26rpx;
  text-align: center;
}

/* —— dock 上的主题切换行。圆点的颜色由 wxml 用 item.accent 内联给出。 —— */
.theme-row {
  display: flex;
  align-items: center;
  padding: 16rpx 40rpx 0;
}

.theme-row-label {
  margin-right: 22rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.theme-dots {
  display: flex;
  align-items: center;
  flex: 1;
}

.theme-dot {
  width: 44rpx;
  height: 44rpx;
  margin-right: 22rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(45, 27, 36, 0.14);
  transition: transform 160ms ease, border-color 160ms ease;
}

.theme-dot.on {
  transform: scale(1.18);
  border-color: rgba(45, 27, 36, 0.55);
}

.theme-row-label {
  color: rgba(45, 27, 36, 0.45);
}

/* —— 其余主题的覆盖规则。色值与 utils/themes.js 一致。 —— */

.theme-matcha {
  background: #F2FAF4;
  color: #1E2B23;
}

.theme-matcha .kicker {
  color: #2E8B62;
}

.theme-matcha .title,
.theme-matcha .num,
.theme-matcha .unit {
  color: #1E2B23;
  text-shadow: 0 4rpx 26rpx rgba(46, 139, 98, 0.18);
}

.theme-matcha .and {
  color: #8FD3A8;
}

.theme-matcha .pill {
  background: rgba(143, 211, 168, 0.16);
}

.theme-matcha .pill-text {
  color: #2E8B62;
}

.theme-matcha .body,
.theme-matcha .meta,
.theme-matcha .note,
.theme-matcha .stat-label {
  color: rgba(30, 43, 35, 0.72);
}

.theme-matcha .meta-lg {
  color: #1E2B23;
}

.theme-matcha .dot.on {
  background: linear-gradient(90deg, #8FD3A8 0%, #8FC7B9 100%);
}

.theme-matcha .dock {
  background: rgba(242, 250, 244, 0.94);
  box-shadow: 0 -10rpx 26rpx rgba(30, 43, 35, 0.05);
}

.theme-matcha .theme-row-label,
.theme-matcha .dock-tip {
  color: rgba(30, 43, 35, 0.46);
}

.theme-matcha .btn-share {
  background: #1E2B23;
  color: #F2FAF4;
  box-shadow: 0 12rpx 28rpx rgba(30, 43, 35, 0.22);
}

.theme-matcha .theme-dot {
  box-shadow: 0 4rpx 12rpx rgba(30, 43, 35, 0.14);
}

.theme-sky {
  background: #F1F6FD;
  color: #1C2A3C;
}

.theme-sky .kicker {
  color: #4A7DBF;
}

.theme-sky .title,
.theme-sky .num,
.theme-sky .unit {
  color: #1C2A3C;
  text-shadow: 0 4rpx 26rpx rgba(74, 125, 191, 0.18);
}

.theme-sky .and {
  color: #A3C4F1;
}

.theme-sky .pill {
  background: rgba(163, 196, 241, 0.16);
}

.theme-sky .pill-text {
  color: #4A7DBF;
}

.theme-sky .body,
.theme-sky .meta,
.theme-sky .note,
.theme-sky .stat-label {
  color: rgba(28, 42, 60, 0.72);
}

.theme-sky .meta-lg {
  color: #1C2A3C;
}

.theme-sky .dot.on {
  background: linear-gradient(90deg, #A3C4F1 0%, #B9A9F0 100%);
}

.theme-sky .dock {
  background: rgba(241, 246, 253, 0.94);
  box-shadow: 0 -10rpx 26rpx rgba(28, 42, 60, 0.05);
}

.theme-sky .theme-row-label,
.theme-sky .dock-tip {
  color: rgba(28, 42, 60, 0.46);
}

