/* 纪念册。奶油底，每页最多两块柔和色晕。
   口头禅页是深玫瑰 #E85A7A，字是白的。 */

.stage {
  width: 100%;
  overflow: hidden;
}

.theme-cream {
  background: #FFF5F7;
  color: #2D1B24;
}

.theme-rose {
  background: #E85A7A;
  color: #FFFFFF;
}

.swiper {
  width: 100%;
}

.slide {
  position: relative;
  overflow: hidden;
}

.shape {
  position: absolute;
  display: none;
  pointer-events: none;
}

.id-cover .shape-1,
.id-cover .shape-2,
.id-numbers .shape-1,
.id-numbers .shape-2,
.id-start .shape-1,
.id-start .shape-2,
.id-distance .shape-1,
.id-phrase .shape-1,
.id-fight .shape-1,
.id-story .shape-1,
.id-ending .shape-1,
.id-ending .shape-2 {
  display: block;
}

/* 每一页的装饰都画成渐变到透明的色晕。
   没有方块、没有直角，边缘是化开的；形状也整个落在页内，
   不会被裁出一条直线。正文在 .content 里，压在装饰上面。 */
.id-cover .shape-1 {
  width: 460rpx;
  height: 460rpx;
  right: 30rpx;
  top: 20rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 138, 171, 0.20) 0%,
    rgba(255, 138, 171, 0.09) 29%,
    rgba(255, 194, 209, 0.03) 48%,
    rgba(255, 194, 209, 0) 62%);
}

.id-cover .shape-2 {
  width: 220rpx;
  height: 220rpx;
  right: 190rpx;
  top: 210rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.42) 0%,
    rgba(255, 194, 209, 0.17) 34%,
    rgba(255, 194, 209, 0) 62%);
}

.id-numbers .shape-1 {
  width: 380rpx;
  height: 560rpx;
  right: 30rpx;
  top: 170rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 138, 171, 0.18) 0%,
    rgba(255, 138, 171, 0.08) 31%,
    rgba(255, 194, 209, 0.02) 48%,
    rgba(255, 194, 209, 0) 62%);
}

.id-numbers .shape-2 {
  width: 190rpx;
  height: 190rpx;
  right: 40rpx;
  top: 30rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.42) 0%,
    rgba(255, 194, 209, 0.17) 34%,
    rgba(255, 194, 209, 0) 62%);
}

.id-start .shape-1 {
  width: 420rpx;
  height: 420rpx;
  right: 30rpx;
  bottom: 40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.38) 0%,
    rgba(255, 194, 209, 0.15) 34%,
    rgba(255, 194, 209, 0) 62%);
}

.id-distance .shape-1 {
  width: 340rpx;
  height: 340rpx;
  right: 40rpx;
  top: 40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.40) 0%,
    rgba(255, 194, 209, 0.16) 34%,
    rgba(255, 194, 209, 0) 62%);
}

.id-phrase .shape-1 {
  width: 440rpx;
  height: 440rpx;
  right: 30rpx;
  bottom: 40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 255, 255, 0.20) 0%,
    rgba(255, 255, 255, 0.09) 33%,
    rgba(255, 255, 255, 0) 62%);
}

.id-fight .shape-1 {
  width: 320rpx;
  height: 540rpx;
  right: 40rpx;
  top: 200rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.36) 0%,
    rgba(255, 194, 209, 0.14) 33%,
    rgba(255, 194, 209, 0) 62%);
}

.id-story .shape-1 {
  width: 260rpx;
  height: 260rpx;
  right: 50rpx;
  top: 40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.40) 0%,
    rgba(255, 194, 209, 0.16) 33%,
    rgba(255, 194, 209, 0) 62%);
}

.id-ending .shape-1 {
  width: 420rpx;
  height: 420rpx;
  left: 30rpx;
  bottom: 40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.40) 0%,
    rgba(255, 194, 209, 0.16) 34%,
    rgba(255, 194, 209, 0) 62%);
}

.id-ending .shape-2 {
  width: 200rpx;
  height: 200rpx;
  right: 50rpx;
  top: 40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.36) 0%,
    rgba(255, 194, 209, 0.14) 34%,
    rgba(255, 194, 209, 0) 62%);
}

.content {
  position: relative;
  z-index: 1;
}

.content-inner {
  padding: 88rpx 64rpx 72rpx;
  max-width: 640px;
}

.kicker {
  display: block;
  margin-bottom: 28rpx;
  font-size: 26rpx;
  letter-spacing: 6rpx;
}

.theme-cream .kicker {
  color: #E85A7A;
}

.theme-rose .kicker {
  color: rgba(255, 255, 255, 0.86);
}

.title {
  display: block;
  font-weight: 600;
  line-height: 1.28;
  word-break: break-all;
}

.title-xl { font-size: 72rpx; }
.title-lg { font-size: 60rpx; }
.title-md { font-size: 48rpx; }
.title-sm { font-size: 40rpx; }

.theme-cream .title,
.theme-cream .num,
.theme-cream .unit {
  color: #2D1B24;
}

.theme-rose .title {
  color: #FFFFFF;
}

.name-line {
  display: flex;
  align-items: flex-end;
  margin-top: 8rpx;
}

.and {
  margin-right: 12rpx;
  margin-bottom: 14rpx;
  font-size: 30rpx;
  color: #FF8FAB;
}

.body,
.meta,
.note,
.stat-label {
  display: block;
}

.body {
  margin-top: 36rpx;
  font-size: 32rpx;
  line-height: 1.75;
  white-space: pre-wrap;
}

.meta {
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.theme-cream .body,
.theme-cream .meta,
.theme-cream .note,
.theme-cream .stat-label {
  color: rgba(45, 27, 36, 0.72);
}

.theme-rose .body,
.theme-rose .meta {
  color: rgba(255, 255, 255, 0.9);
}

.id-cover .body {
  margin-top: 56rpx;
}

.id-cover .meta {
  margin-top: 12rpx;
  font-size: 36rpx;
  color: #2D1B24;
}

.stats {
  margin-top: 48rpx;
}

.stat + .stat {
  margin-top: 40rpx;
}

.stat-line {
  display: flex;
  align-items: baseline;
}

.num {
  font-size: 88rpx;
  font-weight: 600;
  line-height: 1;
}

.unit {
  margin-left: 10rpx;
  font-size: 30rpx;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 28rpx;
}

.note {
  margin-top: 48rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.dock {
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.theme-cream .dock {
  background: #FFF5F7;
  box-shadow: 0 -10rpx 26rpx rgba(45, 27, 36, 0.05);
}

.theme-rose .dock {
  background: #E85A7A;
  box-shadow: 0 -10rpx 26rpx rgba(120, 22, 48, 0.10);
}

.pager-row {
  display: flex;
  align-items: baseline;
  padding: 8rpx 40rpx 0;
}

.pager {
  font-size: 26rpx;
}

.swipe-hint {
  margin-left: 16rpx;
  font-size: 26rpx;
  opacity: 0.7;
}

.dock-actions {
  display: flex;
  padding: 16rpx 32rpx 0;
}

.dock-actions .btn {
  flex: 1;
}

.dock-actions .btn + .btn {
  margin-left: 16rpx;
}

.theme-rose .btn-primary {
  background: #FFFFFF;
  color: #E85A7A;
  box-shadow: 0 12rpx 28rpx rgba(120, 22, 48, 0.18);
}

.theme-rose .btn-ghost {
  color: #FFFFFF;
  border-color: rgba(255, 255, 255, 0.7);
  background: transparent;
}

.mock-line {
  padding: 14rpx 40rpx 8rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.5;
  text-decoration: underline;
}

.theme-cream .mock-line {
  color: rgba(45, 27, 36, 0.62);
}

.theme-rose .mock-line {
  color: rgba(255, 255, 255, 0.92);
}

.empty {
  position: relative;
  height: 100%;
  overflow: hidden;
}

.glow {
  position: absolute;
  display: block;
  pointer-events: none;
}

.empty-glow-1 {
  width: 520rpx;
  height: 520rpx;
  right: -40rpx;
  top: -40rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 138, 171, 0.20) 0%,
    rgba(255, 138, 171, 0.09) 29%,
    rgba(255, 194, 209, 0.03) 48%,
    rgba(255, 194, 209, 0) 62%);
}

.empty-glow-2 {
  width: 280rpx;
  height: 280rpx;
  left: -30rpx;
  bottom: 60rpx;
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 194, 209, 0.42) 0%,
    rgba(255, 194, 209, 0.17) 33%,
    rgba(255, 194, 209, 0) 62%);
}

.empty-inner {
  position: relative;
  z-index: 1;
  padding: 18vh 64rpx 0;
}

.empty-btn {
  margin-top: 24rpx;
}

.empty-inner .body {
  margin-bottom: 36rpx;
}

.poster-canvas {
  position: fixed;
  left: -8000px;
  top: 0;
  pointer-events: none;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(45, 27, 36, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFF5F7;
  border-radius: 36rpx 36rpx 0 0;
}

.sheet-kicker {
  display: block;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #E85A7A;
}

.sheet-title {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #2D1B24;
}

.sheet-scroll {
  max-height: 52vh;
  margin: 20rpx 0 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.sheet-img {
  width: 100%;
  display: block;
}

.sheet-tip {
  display: block;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(45, 27, 36, 0.66);
}

.sheet-actions {
  display: flex;
}

.sheet-actions .btn {
  flex: 1;
}

.sheet-actions .btn + .btn {
  margin-left: 16rpx;
}

.sheet-close {
  margin-top: 18rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(45, 27, 36, 0.55);
}
