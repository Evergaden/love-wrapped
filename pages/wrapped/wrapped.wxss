/* ================= 拆信封（礼物取回等待页） ================= */
/* 一个循环 3.6s：翻盖 3D 打开 → 信纸弹性升起 → 小心心飘出 → 收回合盖。
   配色从主题变量取，跟着当前主题走。 */

.env-stage {
  position: relative;
  width: 340rpx;
  height: 360rpx;
  margin-top: 150rpx;
  margin-bottom: 46rpx;
  align-self: center;
}

/* 主题变量：信纸口红、封盖、内里、飘出的心 */
.theme-cream .env-stage {
  --env-accent: #E85A7A;
  --env-face: #FFD9E3;
  --env-fold: #FFCCDA;
  --env-flap: #FFC2D1;
  --env-back: #F7C0CE;
}

.theme-matcha .env-stage {
  --env-accent: #2E8B62;
  --env-face: #CDEBD8;
  --env-fold: #BEE4CD;
  --env-flap: #C2E7D0;
  --env-back: #AFDABF;
}

.theme-sky .env-stage {
  --env-accent: #4A7DBF;
  --env-face: #D3E4F8;
  --env-fold: #C3D9F4;
  --env-flap: #C7DDF7;
  --env-back: #B4CEF0;
}

.theme-violet .env-stage {
  --env-accent: #7B5BC8;
  --env-face: #E3D6F8;
  --env-fold: #D6C5F4;
  --env-flap: #DAC8F5;
  --env-back: #CBBBEC;
}

/* 信封本体：轻轻浮沉，让等待有呼吸感 */
.env {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 34rpx;
  height: 220rpx;
  perspective: 900rpx;
  animation: envFloat 3.6s ease-in-out infinite;
}

@keyframes envFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

/* 内里（信纸从它前面升起） */
.env-back {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--env-back);
  border-radius: 24rpx;
}

/* 信纸：在封盖后面、兜前面；升起时带一点回弹 */
.env-letter {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 12rpx;
  height: 170rpx;
  z-index: 2;
  background: #FFFEFB;
  border-radius: 14rpx;
  box-shadow: 0 8rpx 24rpx rgba(45, 27, 36, 0.14);
  animation: envLetter 3.6s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@keyframes envLetter {
  0%, 10% {
    transform: translateY(14rpx);
    animation-timing-function: cubic-bezier(0.34, 1.45, 0.64, 1);
  }
  34% { transform: translateY(-158rpx); }
  50% { transform: translateY(-172rpx); }
  64% { transform: translateY(-158rpx); }
  88%, 100% { transform: translateY(14rpx); }
}

/* 信纸上的字迹与落款的心 */
.env-line {
  height: 7rpx;
  border-radius: 7rpx;
  background: rgba(45, 27, 36, 0.13);
  margin: 0 34rpx;
}

.env-line-1 { margin-top: 40rpx; }

.env-line-2 { margin-top: 20rpx; width: 150rpx; }

.env-letter-heart {
  display: block;
  margin-top: 18rpx;
  text-align: right;
  padding-right: 36rpx;
  font-size: 28rpx;
  color: var(--env-accent);
}

/* 前兜：盖住信纸收在里面的部分，两道折痕拼出信封的 V */
.env-front {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 128rpx;
  z-index: 3;
  background: var(--env-face);
  border-radius: 0 0 24rpx 24rpx;
}

.env-front::before,
.env-front::after {
  content: '';
  position: absolute;
  top: -1rpx;
  width: 0;
  height: 0;
}

.env-front::before {
  left: 0;
  border-top: 128rpx solid var(--env-fold);
  border-right: 168rpx solid transparent;
}

.env-front::after {
  right: 0;
  border-top: 128rpx solid var(--env-face);
  border-left: 168rpx solid transparent;
}

/* 封盖：绕上沿 3D 翻开；翻开后降到信纸后面，合上时再回到前面 */
.env-flap {
  position: absolute;
  left: 0;
  top: 0;
  width: 0;
  height: 0;
  border-left: 170rpx solid transparent;
  border-right: 170rpx solid transparent;
  border-top: 134rpx solid var(--env-flap);
  transform-origin: 50% 0;
  animation: envFlap 3.6s linear infinite;
}

@keyframes envFlap {
  0%, 6% {
    transform: rotateX(0deg);
    z-index: 4;
    animation-timing-function: cubic-bezier(0.34, 1.4, 0.64, 1);
  }
  22% { transform: rotateX(-178deg); }
  22.1% { z-index: 1; }
  78% {
    transform: rotateX(-178deg);
    animation-timing-function: cubic-bezier(0.5, 0, 0.7, 0.4);
  }
  94%, 100% {
    transform: rotateX(0deg);
    z-index: 4;
  }
}

/* 飘出的小心心：信纸升起后从信封口陆续浮出来 */
.env-heart {
  position: absolute;
  bottom: 236rpx;
  z-index: 1;
  font-size: 36rpx;
  color: var(--env-accent);
  opacity: 0;
  animation: envHeart 3.6s ease-out infinite;
}

.env-heart.h1 {
  left: 34rpx;
  font-size: 30rpx;
  animation-delay: 1.1s;
}

.env-heart.h2 {
  left: 158rpx;
  font-size: 42rpx;
  animation-delay: 1.8s;
}

.env-heart.h3 {
  left: 268rpx;
  font-size: 32rpx;
  animation-delay: 2.5s;
}

@keyframes envHeart {
  0% {
    opacity: 0;
    transform: translateY(20rpx) scale(0.4) rotate(-12deg);
  }
  16% { opacity: 0.95; }
  62% { opacity: 0.85; }
  100% {
    opacity: 0;
    transform: translateY(-190rpx) scale(1.08) rotate(16deg);
  }
}

/* 地面软影：和信封的浮沉同步缩放 */
.env-shadow {
  position: absolute;
  left: 50%;
  bottom: 14rpx;
  width: 250rpx;
  height: 26rpx;
  margin-left: -125rpx;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(45, 27, 36, 0.13) 0%, rgba(45, 27, 36, 0) 70%);
  animation: envShadow 3.6s ease-in-out infinite;
}

@keyframes envShadow {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(0.88); opacity: 0.75; }
}

/* —— 礼物拆封前的全屏封面：标题大、CTA 压底，像一本年度报告的封皮。 —— */
.gift-splash {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  overflow: hidden;
  background: #FFF5F7;
}

.splash-hearts {
  position: absolute;
  left: 0;
  right: 0;
  top: 20%;
  height: 30%;
  pointer-events: none;
}

.splash-heart {
  position: absolute;
  color: #E85A7A;
  opacity: 0.5;
  animation: splashFloat 3.2s ease-in-out infinite;
}

.splash-heart.h1 {
  left: 18%;
  font-size: 40rpx;
  animation-delay: 0s;
}

.splash-heart.h2 {
  left: 62%;
  top: 40rpx;
  font-size: 30rpx;
  opacity: 0.35;
  animation-delay: 0.9s;
}

.splash-heart.h3 {
  left: 84%;
  top: 120rpx;
  font-size: 34rpx;
  opacity: 0.4;
  animation-delay: 1.7s;
}

@keyframes splashFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-22rpx); }
}

.splash-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22% 60rpx 0;
  text-align: center;
}

.splash-inner .kicker-row {
  justify-content: center;
  margin-bottom: 30rpx;
}

.splash-inner .kicker-bar {
  display: none;
}

.splash-title {
  font-size: 64rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #2D1B24;
  word-break: break-all;
  text-shadow: 0 6rpx 30rpx rgba(232, 90, 122, 0.25);
}

.splash-sub {
  display: block;
  margin-top: 34rpx;
  font-size: 30rpx;
  color: rgba(45, 27, 36, 0.72);
}

.splash-date {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.5);
  letter-spacing: 2rpx;
}

.splash-cta {
  position: fixed;
  left: 50%;
  bottom: calc(90rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  width: 480rpx;
  height: 108rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1C1C1E;
  box-shadow: 0 16rpx 40rpx rgba(28, 28, 30, 0.35);
  z-index: 2;
}

.splash-cta-press {
  transform: translateX(-50%) scale(0.97);
  opacity: 0.9;
}

.splash-cta-text {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #FFFFFF;
}

.splash-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  text-align: center;
  font-size: 22rpx;
  color: rgba(45, 27, 36, 0.4);
  z-index: 2;
}

/* —— 分享面板：起标题用的小抽屉。 —— */
.share-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: rgba(45, 27, 36, 0.35);
  display: flex;
  align-items: flex-end;
}

.share-sheet {
  width: 100%;
  padding: 40rpx 40rpx calc(30rpx + env(safe-area-inset-bottom));
  background: #FFF5F7;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -16rpx 50rpx rgba(45, 27, 36, 0.16);
}

.share-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2D1B24;
}

.share-sheet-input {
  margin-top: 26rpx;
  width: 100%;
  height: 92rpx;
  padding: 0 8rpx;
  background: transparent;
  border: none;
  box-shadow: inset 0 -2rpx 0 rgba(255, 138, 171, 0.5);
  font-size: 32rpx;
  color: #2D1B24;
}

.share-chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 26rpx;
}

.share-chip {
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 24rpx;
  border: 2rpx solid rgba(255, 138, 171, 0.55);
  border-radius: 999rpx;
  background: rgba(255, 245, 247, 0.8);
  font-size: 26rpx;
  color: #2D1B24;
}

.share-chip-on {
  background: rgba(255, 138, 171, 0.22);
  border-color: rgba(232, 90, 122, 0.7);
  color: #E85A7A;
  font-weight: 600;
}

.share-go {
  margin-top: 26rpx;
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #1C1C1E;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  color: #FFFFFF;
  line-height: 1;
}

.share-go::after {
  border: none;
}

.share-cancel {
  margin-top: 22rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(45, 27, 36, 0.5);
}

/* —— 吵架页：依据胶囊居中一行。 —— */
.fight-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 34rpx;
}

.fight-chip {
  margin: 0 12rpx 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
}

.fight-chip-text {
  font-size: 27rpx;
  color: rgba(45, 27, 36, 0.78);
}

.fight-meta {
  margin-top: 32rpx;
  text-align: center;
}

/* —— 获得的评价：徽章 + 大称号 + 依据，居中像领奖台。 —— */
.award-badge {
  align-self: center;
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 18rpx rgba(45, 27, 36, 0.18);
}

.award-badge-text {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #FFFFFF;
}

.award-title-wrap {
  margin-top: 34rpx;
  text-align: center;
}

.award-title-wrap .title {
  text-align: center;
}

.award-reason {
  margin-top: 30rpx;
  text-align: center;
}


/* —— 翻页入场动效：当前页挂 page-in，元素依次浮现。 —— */
.slide.page-in .kicker-row {
  animation: pgFade 0.4s ease both;
}

.slide.page-in .title-wrap {
  animation: pgUp 0.5s ease 0.06s both;
}

.slide.page-in .body {
  animation: pgUp 0.5s ease 0.14s both;
}

.slide.page-in .meta {
  animation: pgUp 0.5s ease 0.2s both;
}

.slide.page-in .pill {
  animation: pgPop 0.45s ease 0.18s both;
}

.slide.page-in .stats .stat {
  animation: pgUp 0.45s ease both;
}

.slide.page-in .stats .stat:nth-child(1) { animation-delay: 0.08s; }
.slide.page-in .stats .stat:nth-child(2) { animation-delay: 0.16s; }
.slide.page-in .stats .stat:nth-child(3) { animation-delay: 0.24s; }
.slide.page-in .stats .stat:nth-child(4) { animation-delay: 0.32s; }

.slide.page-in .stats .num {
  animation: numRoll 0.55s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  animation-delay: 0.12s;
}

.slide.page-in .tile-grid .tile {
  animation: pgPop 0.4s ease both;
}

.slide.page-in .tile-grid .tile:nth-child(1) { animation-delay: 0.05s; }
.slide.page-in .tile-grid .tile:nth-child(2) { animation-delay: 0.12s; }
.slide.page-in .tile-grid .tile:nth-child(3) { animation-delay: 0.19s; }
.slide.page-in .tile-grid .tile:nth-child(4) { animation-delay: 0.26s; }
.slide.page-in .tile-grid .tile:nth-child(5) { animation-delay: 0.33s; }
.slide.page-in .tile-grid .tile:nth-child(6) { animation-delay: 0.4s; }
.slide.page-in .tile-grid .tile:nth-child(7) { animation-delay: 0.47s; }
.slide.page-in .tile-grid .tile:nth-child(8) { animation-delay: 0.54s; }

.slide.page-in .award-badge {
  animation: pgPop 0.45s ease 0.08s both;
}

.slide.page-in .award-title-wrap {
  animation: pgUp 0.5s ease 0.16s both;
}

.slide.page-in .award-reason {
  animation: pgUp 0.5s ease 0.24s both;
}

.slide.page-in .fight-chips .fight-chip {
  animation: pgPop 0.4s ease both;
}

.slide.page-in .fight-chips .fight-chip:nth-child(1) { animation-delay: 0.12s; }
.slide.page-in .fight-chips .fight-chip:nth-child(2) { animation-delay: 0.2s; }

@keyframes pgFade {
  from { opacity: 0; }
}

@keyframes pgUp {
  from { opacity: 0; transform: translateY(26rpx); }
}

@keyframes pgPop {
  from { opacity: 0; transform: scale(0.9); }
}

@keyframes numRoll {
  from { opacity: 0; transform: translateY(0.45em); filter: blur(4px); }
}

/* —— 分享面板与拆封封面跟主题色。 —— */
.theme-matcha .share-sheet { background: #F2FAF4; }
.theme-matcha .share-sheet-title { color: #1E2B23; }
.theme-matcha .share-sheet-input { color: #1E2B23; box-shadow: inset 0 -2rpx 0 rgba(143, 211, 168, 0.5); }
.theme-matcha .share-chip { border-color: rgba(143, 211, 168, 0.6); background: rgba(143, 211, 168, 0.12); color: #1E2B23; }
.theme-matcha .share-chip-on { background: rgba(143, 211, 168, 0.22); border-color: rgba(46, 139, 98, 0.7); color: #2E8B62; }
.theme-matcha .share-cancel { color: rgba(30, 43, 35, 0.5); }
.theme-matcha .splash-title { color: #1E2B23; }
.theme-matcha .splash-sub { color: rgba(30, 43, 35, 0.72); }
.theme-matcha .splash-date { color: rgba(30, 43, 35, 0.5); }
.theme-matcha .splash-foot { color: rgba(30, 43, 35, 0.4); }

.theme-sky .share-sheet { background: #F1F6FD; }
.theme-sky .share-sheet-title { color: #1C2A3C; }
.theme-sky .share-sheet-input { color: #1C2A3C; box-shadow: inset 0 -2rpx 0 rgba(163, 196, 241, 0.5); }
.theme-sky .share-chip { border-color: rgba(163, 196, 241, 0.6); background: rgba(163, 196, 241, 0.12); color: #1C2A3C; }
.theme-sky .share-chip-on { background: rgba(163, 196, 241, 0.22); border-color: rgba(74, 125, 191, 0.7); color: #4A7DBF; }
.theme-sky .share-cancel { color: rgba(28, 42, 60, 0.5); }
.theme-sky .splash-title { color: #1C2A3C; }
.theme-sky .splash-sub { color: rgba(28, 42, 60, 0.72); }
.theme-sky .splash-date { color: rgba(28, 42, 60, 0.5); }
.theme-sky .splash-foot { color: rgba(28, 42, 60, 0.4); }

.theme-violet .share-sheet { background: #F7F4FC; }
.theme-violet .share-sheet-title { color: #2B2144; }
.theme-violet .share-sheet-input { color: #2B2144; box-shadow: inset 0 -2rpx 0 rgba(201, 175, 242, 0.5); }
.theme-violet .share-chip { border-color: rgba(201, 175, 242, 0.6); background: rgba(201, 175, 242, 0.12); color: #2B2144; }
.theme-violet .share-chip-on { background: rgba(201, 175, 242, 0.22); border-color: rgba(123, 91, 200, 0.7); color: #7B5BC8; }
.theme-violet .share-cancel { color: rgba(43, 33, 68, 0.5); }
.theme-violet .splash-title { color: #2B2144; }
.theme-violet .splash-sub { color: rgba(43, 33, 68, 0.72); }
.theme-violet .splash-date { color: rgba(43, 33, 68, 0.5); }
.theme-violet .splash-foot { color: rgba(43, 33, 68, 0.4); }

/* —— 爱吃的东西：一人一张小卡。 —— */
.fave-cards {
  display: flex;
  flex-direction: column;
  margin-top: 34rpx;
}

.fave-card {
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
}

.fave-card-cap {
  display: block;
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: rgba(45, 27, 36, 0.5);
}

.fave-card-text {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.5;
  color: #2D1B24;
}

.fave-card-empty {
  font-weight: 400;
  color: rgba(45, 27, 36, 0.4);
}

.fave-meta {
  margin-top: 30rpx;
  text-align: center;
}

/* 翻页入场动效：爱吃卡也依次浮现。 */
.slide.page-in .fave-cards .fave-card {
  animation: pgPop 0.4s ease both;
}

.slide.page-in .fave-cards .fave-card:nth-child(1) { animation-delay: 0.1s; }
.slide.page-in .fave-cards .fave-card:nth-child(2) { animation-delay: 0.2s; }

.slide.page-in .fave-meta {
  animation: pgUp 0.5s ease 0.3s both;
}

/* —— 封面一行式名字：光晕居中（默认 26% 是为单名堆叠设计的）。 —— */
.cover-oneline .title-glow {
  background: radial-gradient(ellipse at 50% 50%,
    rgba(255, 138, 171, 0.24) 0%,
    rgba(255, 138, 171, 0.07) 48%,
    rgba(255, 138, 171, 0) 76%);
}

.cover-oneline.theme-matcha .title-glow {
  background: radial-gradient(ellipse at 50% 50%,
    rgba(143, 211, 168, 0.24) 0%,
    rgba(143, 211, 168, 0.07) 48%,
    rgba(143, 211, 168, 0) 76%);
}

.cover-oneline.theme-sky .title-glow {
  background: radial-gradient(ellipse at 50% 50%,
    rgba(163, 196, 241, 0.24) 0%,
    rgba(163, 196, 241, 0.07) 48%,
    rgba(163, 196, 241, 0) 76%);
}

.cover-oneline.theme-violet .title-glow {
  background: radial-gradient(ellipse at 50% 50%,
    rgba(201, 175, 242, 0.24) 0%,
    rgba(201, 175, 242, 0.07) 48%,
    rgba(201, 175, 242, 0) 76%);
}

/* —— 距离页（旅程图）入场：数字滚动、虚线生长、端点弹出。 —— */
.slide.page-in .journey-num-row {
  animation: pgUp 0.5s ease 0.06s both;
}

.slide.page-in .journey-num {
  animation: numRoll 0.6s cubic-bezier(0.2, 0.7, 0.3, 1) both;
  animation-delay: 0.15s;
}

.slide.page-in .journey-line {
  animation: lineGrow 0.55s ease 0.3s both;
  transform-origin: left center;
}

@keyframes lineGrow {
  from { transform: scaleX(0); opacity: 0; }
}

.slide.page-in .journey-cap {
  animation: pgPop 0.35s ease 0.5s both;
}

.slide.page-in .journey-label {
  animation: pgUp 0.5s ease 0.45s both;
}

.slide.page-in .journey-meta {
  animation: pgUp 0.5s ease 0.55s both;
}

/* —— 拆信封邮票弹出。 —— */
.slide.page-in .stamp {
  animation: pgPop 0.45s ease 0.2s both;
}

/* —— 气泡弹出。 —— */
.slide.page-in .bubble-wrap {
  animation: pgUp 0.5s ease 0.15s both;
}

/* —— 手记色条生长。 —— */
.slide.page-in .letter-bar {
  animation: barGrow 0.5s ease 0.15s both;
  transform-origin: top center;
}

@keyframes barGrow {
  from { transform: scaleY(0); opacity: 0; }
}

/* —— 称号徽章 / 爱吃卡 / 吵架胶囊错峰入场。 —— */
.slide.page-in .award-badge { animation: pgPop 0.45s ease 0.08s both; }
.slide.page-in .award-title-wrap { animation: pgUp 0.5s ease 0.16s both; }
.slide.page-in .award-reason { animation: pgUp 0.5s ease 0.24s both; }
.slide.page-in .fave-cards .fave-card { animation: pgPop 0.4s ease both; }
.slide.page-in .fave-cards .fave-card:nth-child(1) { animation-delay: 0.1s; }
.slide.page-in .fave-cards .fave-card:nth-child(2) { animation-delay: 0.2s; }
.slide.page-in .fave-meta { animation: pgUp 0.5s ease 0.3s both; }
.slide.page-in .fight-chips .fight-chip { animation: pgPop 0.4s ease both; }
.slide.page-in .fight-chips .fight-chip:nth-child(1) { animation-delay: 0.12s; }
.slide.page-in .fight-chips .fight-chip:nth-child(2) { animation-delay: 0.2s; }

/* —— 取回礼物的极简态：三颗心跳动。 —— */
.fetch-dots {
  display: flex;
  justify-content: center;
  margin-top: 220rpx;
}

.fetch-dot {
  margin: 0 14rpx;
  font-size: 34rpx;
  color: #E85A7A;
  opacity: 0.6;
  animation: fetchBeat 1.1s ease-in-out infinite;
}

.fetch-dot.d2 { animation-delay: 0.18s; }
.fetch-dot.d3 { animation-delay: 0.36s; }

@keyframes fetchBeat {
  0%, 100% { opacity: 0.35; transform: scale(0.9); }
  50% { opacity: 0.9; transform: scale(1.08); }
}

.fetch-text {
  display: block;
  margin-top: 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: rgba(45, 27, 36, 0.5);
}
