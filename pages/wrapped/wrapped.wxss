/* 纪念册。每一页铺一层弥散光，正文浮在一块磨砂卡上。
   奶油底 #FFF5F7，粉 #FF8FAB、#FFC2D1，字 #2D1B24。
   蜜桃 #FFB583、薰衣草 #B79CFF 只出现在弥散底和卡面上，
   导出图片的同色在 utils/poster.js 里，改颜色时三处一起改。 */

.stage {
  position: relative;
  width: 100%;
  overflow: hidden;
}

.theme-cream {
  background: #FFF5F7;
  color: #2D1B24;
}


.swiper {
  width: 100%;
}

.slide {
  position: relative;
  overflow: hidden;
}

.content {
  position: relative;
  z-index: 1;
}

/* 卡片撑满整页：外圈只留一圈窄边给弥散底，
   短的一页也不会吊在中间、上下空一大片。 */
.content-inner {
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 28rpx 36rpx 32rpx;
}

.card {
  position: relative;
  flex: 1 0 auto;
  display: flex;
  flex-direction: column;
  padding: 48rpx 44rpx 44rpx;
  border-radius: 40rpx;
  /* 卡面压得薄一点，让底下的弥散能透上来，空白处就不是死白。 */
  background: rgba(255, 255, 255, 0.40);
  box-shadow:
    inset 0 0 0 2rpx rgba(255, 255, 255, 0.72),
    0 26rpx 60rpx rgba(45, 27, 36, 0.12);
}

/* 卡里的正文占满剩下的高度，上下居中；落款钉在最下面。 */
.card-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}







/* 卡口那道渐变细线。往里缩一点，避开圆角，才不会在拐角处翘出卡外。 */
.hairline {
  position: absolute;
  left: 44rpx;
  right: 44rpx;
  top: 0;
  height: 6rpx;
}

.kicker-row {
  display: flex;
  align-items: center;
  margin-bottom: 26rpx;
}

.kicker-bar {
  width: 30rpx;
  height: 8rpx;
  margin-right: 14rpx;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #FF8FAB 0%, #B79CFF 100%);
}

.kicker {
  display: block;
  font-size: 26rpx;
  letter-spacing: 6rpx;
}

.theme-cream .kicker {
  color: #E85A7A;
}

/* 标题浸在一团光里。 */
.title-wrap {
  position: relative;
}

.title-glow {
  position: absolute;
  left: -110rpx;
  right: -110rpx;
  top: -80rpx;
  bottom: -64rpx;
  pointer-events: none;
  background: radial-gradient(ellipse at 26% 50%,
    rgba(255, 138, 171, 0.24) 0%,
    rgba(255, 138, 171, 0.07) 48%,
    rgba(255, 138, 171, 0) 76%);
}

.title {
  position: relative;
  display: block;
  font-weight: 600;
  line-height: 1.28;
  word-break: break-all;
}

.title-xl { font-size: 72rpx; }
.title-lg { font-size: 60rpx; }
.title-md { font-size: 48rpx; }
.title-sm { font-size: 40rpx; }

.theme-cream .title,
.theme-cream .num,
.theme-cream .unit {
  color: #2D1B24;
  text-shadow: 0 4rpx 26rpx rgba(232, 90, 122, 0.18);
}

.name-line {
  display: flex;
  align-items: flex-end;
  margin-top: 10rpx;
}

.and {
  margin-right: 14rpx;
  margin-bottom: 16rpx;
  font-size: 30rpx;
  color: #FF8FAB;
}

/* 封面上的日期小胶囊。 */
.pill {
  display: inline-block;
  margin-top: 38rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: rgba(255, 138, 171, 0.16);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.75);
}

.pill-text {
  font-size: 27rpx;
  color: #E85A7A;
}

.body,
.meta,
.note,
.stat-label {
  display: block;
}

.body {
  margin-top: 34rpx;
  font-size: 32rpx;
  line-height: 1.8;
  white-space: pre-wrap;
}

.meta {
  margin-top: 22rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.meta-lg {
  margin-top: 24rpx;
  font-size: 40rpx;
  font-weight: 600;
}

.theme-cream .body,
.theme-cream .meta,
.theme-cream .note,
.theme-cream .stat-label {
  color: rgba(45, 27, 36, 0.72);
}

.theme-cream .meta-lg {
  color: #2D1B24;
}

/* 数字页：每个数一张小卡，两行排开。 */
.stats {
  margin-top: 40rpx;
}

.stat {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 26rpx 30rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.46);
  box-shadow: inset 0 0 0 2rpx rgba(255, 255, 255, 0.72);
}

.stat-line {
  display: flex;
  align-items: baseline;
  flex: none;
}

.num {
  font-size: 68rpx;
  font-weight: 600;
  line-height: 1;
}

.unit {
  margin-left: 8rpx;
  font-size: 26rpx;
}

.stat-label {
  margin-top: 0;
  max-width: 48%;
  text-align: right;
  font-size: 27rpx;
}

.note {
  margin-top: 36rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 落款。 */
.sign {
  margin-top: 44rpx;
}

.sign-line {
  height: 2rpx;
  background: linear-gradient(90deg, rgba(45, 27, 36, 0.16), rgba(45, 27, 36, 0));
}

.sign-text {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: rgba(45, 27, 36, 0.42);
}

.dock {
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
}

.theme-cream .dock {
  background: rgba(255, 245, 247, 0.94);
  box-shadow: 0 -10rpx 26rpx rgba(45, 27, 36, 0.05);
}

.pager-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 40rpx 0;
}

/* 进度用一道道短条，不用圆点。 */
.dots {
  display: flex;
  align-items: center;
}

.dot {
  width: 18rpx;
  height: 6rpx;
  margin-right: 8rpx;
  border-radius: 6rpx;
  background: rgba(45, 27, 36, 0.14);
  transition: width 200ms ease, background 200ms ease;
}

.dot.on {
  width: 44rpx;
  background: linear-gradient(90deg, #FF8FAB 0%, #B79CFF 100%);
}

.pager-right {
  display: flex;
  align-items: baseline;
}

.pager {
  font-size: 26rpx;
}

.swipe-hint {
  margin-right: 16rpx;
  font-size: 26rpx;
  opacity: 0.7;
}

.dock-actions {
  display: flex;
  padding: 16rpx 32rpx 0;
}

.dock-actions .btn {
  flex: 1;
}

.dock-actions .btn + .btn {
  margin-left: 16rpx;
}

/* 分享按钮。单独一行，做成一支「邮票」的样式：
   左边一道虚线齿孔，右边一颗小心，和上面两个导出按钮区分开。 */
.dock-share {
  padding: 16rpx 32rpx 0;
}

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin: 0;
  padding: 0;
  border: none;
  border-radius: 999rpx;
  background: #2D1B24;
  color: #FFF5F7;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 92rpx;
  letter-spacing: 2rpx;
  box-shadow: 0 12rpx 28rpx rgba(45, 27, 36, 0.22);
}

.btn-share::after {
  border: none;
}

.pressedShare {
  opacity: 0.86;
  transform: scale(0.985);
}

/* 底部那句说明。现在不承担「点它解锁」的作用，只是说明。 */
.dock-tip {
  padding: 14rpx 40rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.5;
}

.theme-cream .dock-tip {
  color: rgba(45, 27, 36, 0.46);
}

.empty {
  position: relative;
  height: 100%;
  overflow: hidden;
}

.amb-lower {
  top: 46%;
  bottom: -8%;
  opacity: 0.7;
}

.empty-inner {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-height: 100%;
  padding: 48rpx 40rpx 64rpx;
}

/* 空状态那张卡按内容大小居中就好，不用撑满。 */
.empty-inner .card {
  flex: none;
  margin: auto 0;
}

.empty-btn {
  margin-top: 24rpx;
}

.empty-inner .body {
  margin-bottom: 34rpx;
}

.poster-canvas {
  position: fixed;
  left: -8000px;
  top: 0;
  pointer-events: none;
}

/* 分享封面用的画布，同样挪出屏幕，否则会压住 dock。 */
.share-canvas {
  position: fixed;
  left: -8000px;
  top: 0;
  pointer-events: none;
}

.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 20;
  background: rgba(45, 27, 36, 0.28);
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #FFF5F7;
  border-radius: 36rpx 36rpx 0 0;
}

.sheet-kicker {
  display: block;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #E85A7A;
}

.sheet-title {
  display: block;
  margin-top: 6rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #2D1B24;
}

.sheet-scroll {
  max-height: 52vh;
  margin: 20rpx 0 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.sheet-img {
  width: 100%;
  display: block;
}

.sheet-tip {
  display: block;
  margin-bottom: 18rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(45, 27, 36, 0.66);
}

.sheet-actions {
  display: flex;
}

.sheet-actions .btn {
  flex: 1;
}

.sheet-actions .btn + .btn {
  margin-left: 16rpx;
}

.sheet-close {
  margin-top: 18rpx;
  text-align: center;
  font-size: 28rpx;
  color: rgba(45, 27, 36, 0.55);
}
